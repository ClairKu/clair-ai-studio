  "definitions": {
    "scope": "全部指标强制 broker=0009（小顾独立渠道），与且慢 0008 物理隔离、无重叠；与且慢App内AI小顾（ai-iris/qm-pilot，broker 0008）为不同产品线",
    "registered": "ying99_smartadvisor.user 表 count(*)，含 status=DELETED；ACTIVE 25592 = src QIEMAN 74 + src BAIDU 25518",
    "verified_identity": "user.identity_no 非空（user.verified 字段全为0不落库，不可用）",
    "accounts_opened": "ying99_accounts.account 交易账户（经实名用户 broker_user_id 清单关联）",
    "valid_bank_cards": "ying99_accounts.payment_method：active 且 deleted_on 为 1970 零值占位；一个账户可多卡",
    "purchase": "ying99_fundtxn.fund_order：fund_order_code IN (A22申购, A20认购) 且 confirm_status IN (2确认成功, 3部分确认)；金额=success_amount；不含 W2xx 宝类资金操作（W220充值/W221购买/W98快取等）、不含 A36x 基金转换",
    "redeem": "fund_order_code=A24 且 confirm_status IN (2,3)；赎回无支付环节，pay_status 不适用；金额=success_amount（金额非份额）",
    "net_purchase": "申购−赎回；转换（A36/A363/A364）双边调仓不计入",
    "first_purchase_users": "每交易账户(account_id)首笔成功申购（MIN(fund_order_day)），按首笔年份归类后各年求和=428 去重累计",
    "portfolio_orders": "ying99_potrade.portfolio_order 全状态；组合交易 2022-12-02 才对外，2021-12 的 95 笔为测试/灰度单",
    "aum": "ying99_asset.dwd_ast_aum_user_mv_1d_delta：distinct account3_id 与 sum(total_asset)，数仓 T-1 且仅交易日产出",
    "non_money_aum": "2026-08 月末持仓明细穿透（组合底层+单基金）× fund_info.fund_invest_type：非货=01股票+02债券+03混合+08商品，货=04货币",
    "baidu_authorized_login_users": "ying99_smartadvisor.baidu_user_map distinct broker_user_id（有百度 unionid=至少一次百度授权登录，含小程序入口）",
    "activity": "交易活跃=时间窗内有委托的账户去重（fund_order 按 account_id、组合按 account3_id，两者不可直接合并去重）",
    "test_accounts": "bmdj 维护白名单测试手机号 2 个、影响 ≤3 账户（<0.02%，未单独剔除）；2021-08~10 的 26 个注册为内测期账户；DELETED 182 已单列未计入 ACTIVE",
    "units": "金额单位人民币元；人数/笔数为整数"
  },
  "corrections": {
