<!doctype html><html lang="zh-CN" data-clair-encrypted-report="true" data-clair-independent-encryption="true" data-clair-private-envelope="v1"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><meta name="referrer" content="no-referrer"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; frame-src 'self' blob:; connect-src 'none'; img-src data: blob:; font-src data:; object-src 'none'; base-uri 'none'; form-action 'none'"><title>OAP策略分组授权核查｜网页重制版</title><style>*{box-sizing:border-box}body{margin:0;min-height:100dvh;display:grid;place-items:center;padding:24px;background:#f4f2ed;color:#1d3049;font:15px/1.8 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.card{width:min(620px,100%);padding:38px;border:1px solid #d8dfe6;background:#fff;border-radius:12px}h1{font-size:29px;line-height:1.4}p{color:#65758b}input{width:100%;padding:12px;margin:10px 0;border:1px solid #bac6d2;border-radius:5px;font:inherit}button{border:0;background:#18314f;color:#fff;padding:10px 16px;border-radius:5px;cursor:pointer;font:inherit}button:disabled{opacity:.5}.status{min-height:26px;color:#945340}a{color:#345e8a}.bar{height:54px;display:flex;gap:12px;align-items:center;justify-content:space-between;background:#152c48;color:#fff;padding:0 16px;font-size:12px}.bar a{color:white}.bar button{font-size:12px;padding:5px 10px;border:1px solid #ffffff55}.bar-actions{display:flex;gap:12px;align-items:center}body.open{display:block;padding:0}iframe{display:block;width:100%;height:calc(100dvh - 54px);border:0;background:white}[hidden]{display:none!important}@media(max-width:600px){.bar-title{display:none}.card{padding:25px}}</style></head><body><main class="card" id="lock"><p>CLAIR / PRIVATE REPORT</p><h1>OAP策略分组授权核查｜网页重制版</h1><p>完整独立 HTML。请先打开你的专属阅读入口，即可在本次会话内浏览这批报告。</p><form id="unlock" data-gate="decrypt"><label for="key">访问钥匙</label><input id="key" type="password" autocomplete="off" spellcheck="false"><button id="open" type="submit">打开报告</button></form><div class="status" id="status" role="status" aria-live="polite"></div><a href="../recent-reports-2026-11-24/">返回报告目录</a></main><section id="viewer" hidden><div class="bar"><span class="bar-title">OAP策略分组授权核查｜网页重制版</span><div class="bar-actions"><a href="../recent-reports-2026-11-24/">报告目录</a><a href="../../">工作台</a><button id="download" type="button">下载独立 HTML</button><button id="close" type="button">锁上</button></div></div><iframe id="frame" title="OAP策略分组授权核查｜网页重制版" sandbox="allow-scripts allow-same-origin allow-downloads allow-modals allow-popups allow-popups-to-escape-sandbox"></iframe></section><script>
"use strict";
const payload={"version":1,"algorithm":"AES-GCM","kdf":"PBKDF2","hash":"SHA-256","iterations":310000,"compression":"gzip","salt":"quqj8NF4hEAqsZnBI4xF45KUArtDr8Ba","iv":"pSkG4ZWb+Tt+VRTC","data":""};
const cacheKey="clair-private-report-key:pm-ecology-2026-11-24";
const filename="oap-strategy-groups-audit-2026-11-18.html";
const b64=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
const input=document.getElementById('key'),status=document.getElementById('status'),button=document.getElementById('open'),frame=document.getElementById('frame');
let plain='',busy=false;
const readKey=()=>{try{return sessionStorage.getItem(cacheKey)||''}catch{return ''}};
async function openReport(value){if(busy)return;if(!value){status.textContent='请先打开专属阅读入口。';return}busy=true;button.disabled=true;status.textContent='正在打开完整报告…';try{const material=await crypto.subtle.importKey('raw',new TextEncoder().encode(value),'PBKDF2',false,['deriveKey']);const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b64(payload.salt),iterations:payload.iterations,hash:'SHA-256'},material,{name:'AES-GCM',length:256},false,['decrypt']);const bytes=await crypto.subtle.decrypt({name:'AES-GCM',iv:b64(payload.iv)},key,b64(payload.data));plain=await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).text();frame.srcdoc=plain;try{sessionStorage.setItem(cacheKey,value)}catch{}input.value='';document.body.classList.add('open');document.getElementById('lock').hidden=true;document.getElementById('viewer').hidden=false;status.textContent=''}catch{status.textContent='访问钥匙不匹配，请重新打开专属阅读入口。'}finally{busy=false;button.disabled=false}}
document.getElementById('unlock').addEventListener('submit',e=>{e.preventDefault();void openReport(input.value.trim())});
document.getElementById('download').addEventListener('click',()=>{if(!plain)return;const url=URL.createObjectURL(new Blob([plain],{type:'text/html;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download=filename;a.click();setTimeout(()=>URL.revokeObjectURL(url),3000)});
document.getElementById('close').addEventListener('click',()=>{try{sessionStorage.removeItem(cacheKey)}catch{}frame.srcdoc='';plain='';document.body.classList.remove('open');document.getElementById('viewer').hidden=true;document.getElementById('lock').hidden=false});
let supplied=new URLSearchParams(location.hash.slice(1)).get('k');if(location.hash)history.replaceState(null,'',location.pathname+location.search);if(supplied||readKey())void openReport(supplied||readKey());supplied='';
</script></body></html>