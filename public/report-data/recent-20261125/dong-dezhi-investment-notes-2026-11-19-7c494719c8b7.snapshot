k{font-size:19px;color:var(--muted);line-height:1.8;margin-bottom:22px}.article-meta{display:flex;gap:8px;flex-wrap:wrap;font-size:13px;color:var(--muted);margin-bottom:29px}.article-body{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:33px 35px}.article-body p{font-family:var(--serif);font-size:var(--body-size);line-height:2.1;text-align:justify;margin:0 0 24px;letter-spacing:.2px}.article-body h2{font-size:22px;line-height:1.6;margin:29px 0 13px}.article-body h2:first-child{margin-top:0}.callout{background:var(--soft);border-left:3px solid var(--accent);padding:19px 20px;margin:24px 0;border-radius:0 8px 8px 0}.callout strong{font-size:15px}.callout p{font:16px/1.9 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;margin:7px 0 0}.callout.amber{background:#fff5e4;border-color:#c28a29}.causal-flow{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0 14px}.causal-flow div{position:relative;background:var(--soft);border:1px solid #cfdbed;border-radius:8px;min-height:75px;padding:16px 11px;font-size:15px;display:grid;place-items:center;text-align:center}.causal-flow div+div:before{content:"›";position:absolute;left:-10px;color:var(--muted);background:var(--paper);width:8px;font-size:21px}.causal-caption{font-size:13px;color:var(--muted);margin-bottom:20px}.read-aside{position:sticky;top:100px}.aside-box{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:19px;margin-bottom:15px}.aside-box h3{font-size:15px;margin-bottom:13px}.toc-item{display:block;background:transparent;text-align:left;border-left:2px solid var(--line);padding:7px 0 7px 12px;font-size:14px;line-height:1.7;color:var(--muted);width:100%;margin:3px 0}.toc-item:hover{color:var(--accent)}.toc-item.current{border-color:var(--accent);color:var(--accent);font-weight:600}.terms-list button{font-size:13px;padding:5px 9px;margin:3px 3px 3px 0;border:1px solid var(--line);border-radius:5px;background:var(--paper)}textarea{width