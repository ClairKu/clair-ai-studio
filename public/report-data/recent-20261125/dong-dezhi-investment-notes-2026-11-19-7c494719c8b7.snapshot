none}.modal-card{width:700px;max-width:100%;background:var(--paper);border-radius:14px;box-shadow:0 20px 70px #0003;padding:25px}.modal-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px}.modal-title h2{margin:0;font-size:22px}.modal-title button{width:36px;height:36px;border-radius:50%;background:var(--bg);font-size:23px}.modal input{margin-bottom:12px;max-width:none}.search-results{max-height:55vh;overflow:auto}.search-result{display:block;width:100%;padding:15px 9px;border-top:1px solid var(--line);background:transparent;text-align:left}.search-result strong{font-size:17px}.search-result span{display:block;font-size:13px;color:var(--muted);margin-top:5px}.search-result:hover{background:var(--soft)}.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;border:1px solid #5b7093;border-radius:8px;padding:10px 18px;z-index:120;font-size:14px;box-shadow:0 6px 30px #0002}.toast[hidden]{display:none}.noscript{padding:40px;font-size:19px}.dark{--bg:#111a2a;--paper:#18243a;--ink:#e1e8f5;--muted:#a3b2c9;--line:#34425a;--soft:#233856;--accent:#85b2ff}.dark .primary{background:#b8d0f7;color:#15243d;border-color:#b8d0f7}.dark .quadrant button{background:#22354d!important}.dark .quadrant button span,.dark .quadrant button em{color:#b6c7dd}.dark .callout.amber{background:#3a3022}.dark .source-note{color:#a8b8d0}.dark .causal-flow div{border-color:#445778}.dark .cover{color:#fff}.dark .hero-visual{border:1px solid #344563}.dark .modal-card .modal-title button{color:var(--ink)}@media(min-width:1650px){.main{padding-left:60px;padding-right:60px}}@media(max-width:1250px){.shell{grid-template-columns:214px minmax(0,1fr)}.sidebar{width:214px;padding:26px 15px}.main{padding:30px 28px 60px}.topbar{padding:0 28px}.read-layout{grid-template-columns:minmax(0,1fr) 230px;gap:23px}.article-body{padding:27px}.hero{gap:24px}.book-info{padding:15px}.cover{padding:21px 16px}.cover-name{font-size:20px}.kpi strong{font-size:21px}.control label{flex-wrap:wrap}}@media(max-width:1020px){.books-grid{grid-template-columns:1fr 1fr}.hero{grid-template-columns:1fr}.hero-visual{min-height:0}.lens-grid{grid-template-columns:repeat(4,1fr);gap:8px;margin-top:13px}.lens{padding:11px}.lens strong{font-size:17px}.read-layout{grid-template-columns:minmax(0,1fr)}.read-aside{position:static;display:grid;grid-template-columns:1fr 1fr;gap:13px}.aside-box:first-child{display:none}.aside-box{margin:0}.lab-layout{grid-template-columns:1fr}.kpi-grid{grid-template-columns:1fr 1fr}.top-caption{max-width:200px}.top-caption strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.split-grid{grid-template-columns:1fr}.map-grid{grid-template-columns:1fr}}@media(max-width:760px){.shell{display:block}.sidebar{transform:translateX(-100%);transition:transform .2s;width:260px;box-shadow:15px 0 60px #0004}.sidebar.open{transform:translateX(0)}.workspace{width:100%}.topbar{padding:0 18px;height:66px;gap:8px}.menu-toggle{display:inline-flex;font-size:19px;padding:5px 10px}.top-caption{display:none}.top-actions{gap:7px}.tool{font-size:13px;padding:7px 10px}.tool .search-label{display:none}.main{padding:26px 20px 50px}.hero{padding-top:3px;gap:24px}.hero h1{font-size:39px;letter-spacing:-1px}.hero h1 span{font-size:25px}.hero-copy{font-size:16px}.hero-visual{padding:20px}.lens-grid{grid-template-columns:1fr 1fr}.books-grid{gap:13px}.book-info h3{font-size:17px}.book-info p{font-size:14px}.cover{min-height:156px;padding:17px 15px}.cover-name{font-size:21px;margin-top:15px}.section-title h2{font-size:23px}.section-title span{font-size:13px}.page-head h1{font-size:30px}.unit-list{grid-template-columns:1fr}.reading .article-title{font-size:29px;line-height:1.5}.reading .deck{font-size:17px}.article-body{padding:24px 21px}.article-body p{line-height:2}.article-body h2{font-size:20px}.read-aside{grid-template-columns:1fr}.causal-flow{grid-template-columns:1fr;gap:12px}.causal-flow div{min-height:50px;padding:10px}.causal-flow div+div:before{content:"↓";left:50%;top:-18px;width:20px;font-size:15px;transform:translateX(-50%)}.controls{grid-template-columns:1fr;padding:20px;gap:19px}.quadrant button{min-height:142px;padding:19px 14px}.quadrant strong{font-size:18px}.chart-panel{padding:18px 12px}.chart-panel svg{min-width:0}.kpi{padding:14px}.kpi strong{font-size:23px}.glossary-grid{grid-template-columns:1fr}.timeline-entry{grid-template-columns:1fr;gap:9px;padding:24px 0}.timeline-content{padding-left:17px}.footer{margin-top:32px}.modal{padding-top:7vh}.modal-card{padding:19px}.lesson-actions{display:block}.lesson-actions>button{margin-bottom:14px}.lesson-nav{justify-content:space-between}.lab-tabs button{font-size:14px;padding:8px 12px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}@media print{.sidebar,.topbar,.read-aside,.lesson-actions,.footer,.modal{display:none!important}.shell,.workspace,.main{display:block;width:100%;margin:0;padding:0}.article-body{border:0}.read-layout{display:block}.reading .article-title{font-size:26px}.article-body p{font-size:12pt}.dark{--bg:#fff;--paper:#fff;--ink:#000;--muted:#444}}
</style>
</head>
<body>
<div class="shell">
<aside class="sidebar" id="sidebar" aria-label="阅读导航"></aside>
<div class="workspace">
<header class="topbar">
 <button class="tool menu-toggle" id="menuToggle" aria-label="打开阅读导航" aria-expanded="false">☰</button>
 <div class="top-caption">READING ROOM<strong id="breadcrumb">董德志 · 投资交易笔记</strong></div>
 <div class="top-actions">
  <button class="tool" id="searchOpen" aria-label="搜索全部导读">⌕ <span class="search-label">搜索导读</span></button>
  <button class="tool" id="fontToggle" aria-label="切换阅读字号">字号 <span id="fontLabel">18</span></button>
  <button class="tool" id="themeToggle" aria-label="切换深浅主题">深色</button>
  <a class="tool" href="https://clairku.github.io/clair-ai-studio/">工作台</a>
 </div>
</header>
<main id="main" class="main" tabindex="-1"></main>
</div>
</div>
<div id="searchModal" class="modal" hidden role="dialog" aria-modal="true" aria-label="搜索导读">
 <div class="modal-card"><div class="modal-title"><h2>搜索这间阅读室</h2><button data-close="search" aria-label="关闭搜索">×</button></div><input class="filter-input" id="searchInput" placeholder="搜索主题、术语或一个问题…" aria-label="搜索导读内容"><div class="search-results" id="searchResults"></div></div>
</div>
<div id="termModal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="termTitle">
 <div class="modal-card"><div class="modal-title"><h2 id="termTitle"></h2><button data-close="term" aria-label="关闭术语解释">×</button></div><p id="termBody"></p><div id="termRelated" class="pills"></div></div>
</div>
<div class="toast" id="toast" hidden aria-live="polite"></div>
<noscript><div class="noscript">请启用JavaScript以阅读16个导读单元和使用交互图解。本页面是基于公开书目制作的原创导览，未包含原书全文。</div></noscript>
<script>
const DATA={"books": [{"id": "b1", "name": "投资交易笔记", "suffix": "第一册", "years": "2002—2010", "published": "2011", "isbn": "9787514106701", "color": "#b43d4c", "concept": "建立利率的坐标系", "summary": "从早期债市复盘进入利率分析，先分清增长、通胀、政策利率与市场利率之间的关系。", "themes": ["市场历史复盘", "基本利率关系", "经济增长与通胀"], "source": "https://www.megbook.com.tw/mall/detail.jsp?proID=1770049"}, {"id": "b2", "name": "投资交易笔记（续）", "suffix": "第二册", "years": "2011—2015", "published": "2016", "isbn": "9787514172331", "color": "#285db7", "concept": "把货币和信用拆开看", "summary": "在基本面之外增加资金、信用与供需的视角，理解同一个“宽松”为什么可能对应不同的债市环境。", "themes": ["货币与信用", "供需分析", "信用债研究"], "source": "https://www.sanmin.com.tw/product/index/006973817"}, {"id": "b3", "name": "投资交易笔记（三）", "suffix": "第三册", "years": "2016—2018", "published": "2019", "isbn": "9787521805451", "color": "#ad7918", "concept": "理解框架失灵的时刻", "summary": "公开简介将这一阶段称为非典型周期，并把观察维度扩展到利率、利差、波动率与超长期债券。", "themes": ["非典型周期", "利率与利差", "超长债与波动"], "source": "https://www.zcycjy.com/readBooks?bookCde=2019071919&switChover=1"}, {"id": "b4", "name": "投资交易笔记（四）", "suffix": "第四册", "years": "2019—2022", "published": "2023", "isbn": "9787521852592", "color": "#7354a8", "concept": "让多个市场彼此验证", "summary": "公开目录进一步涉及信贷库存周期、股债收益差、前瞻指标与不同市场的流动性，延伸到多资产观察。", "themes": ["信贷库存周期", "跨资产验证", "前瞻指标与流动性"], "source": "https://www.sanmin.com.tw/product/index/012815827"}], "units": [{"id": "b1-1", "book": "b1", "title": "先把债券价格与收益率读对", "deck": "看到“利率下降”，先确认说的是哪一种利率。", "sections": [{"title": "一笔未来的钱，今天值多少？", "text": "固定利率债券约定了一串未来现金流：定期利息和到期本金。市场收益率相当于把未来的钱折算到今天的折扣。现金流不变时，折扣率越高，现值越低。所以收益率上行，债券价格通常下跌。票息是合同上的比例，收益率则随成交价格变化，两者不能混用。"}, {"title": "市场说的“债牛”，方向与利率相反", "text": "债券牛市通常对应价格上涨、收益率下降。读历史复盘时，可以先在纸上写好这对关系，否则很容易把后面的判断整个翻转。还要区分央行政策工具的利率、银行间融资利率和国债收益率，它们有关联，却不必在同一天、以同一幅度变动。"}, {"title": "把这件事变成一个阅读动作", "text": "每遇到“利率”两个字，都补上品种、期限和时间。例如“10年期国债到期收益率在本周下行”，比“利率降了”包含更多信息。原书第一册的利率关系主题，适合配合这种标注方法阅读。"}], "chain": ["约定未来现金流", "市场折现率变化", "现值反向变化"], "example": "假设面值100元、年票息3%、剩余10年的债券，年付息一次。在收益率3%时价格为100元；若立即变为4%，按同一组现金流重新折现，价格约91.89元。这个例子没有经过一年，也没有包含一年票息收入。", "pitfall": "把到期收益率当作未来一年的保证回报。持有期内仍可能发生价格变化、违约和再投资差异。", "question": "一只债券的票息不变，为什么收益率还能上升？", "answer": "收益率是价格与未来现金流之间的隐含折现率；成交价格下降时，同样的现金流对应更高的收益率。", "terms": ["票息", "到期收益率", "基点"], "lab": "duration"}, {"id": "b1-2", "book": "b1", "title": "增长与通胀：两条线分别在说什么", "deck": "读宏观，重点是分清方向、速度和预期差。", "sections": [{"title": "增长描述需求，通胀描述价格", "text": "实际增长与物价变化可以同向，也可以背离。需求改善可能推高企业融资需求；价格压力又可能影响货币政策与名义利率。因此，只看一个增长数字，很难完成对债市的解释。更好的方式是同时记录增长的边际变化、通胀的边际变化和政策反应。"}, {"title": "边际变化不等于绝对水平", "text": "增长仍然较低，却已经从更低处回升；通胀仍然为正，却已经连续放缓。这两组表述并不矛盾。市场有时交易的是变化方向，而非数字高低。进一步还要问：这些变化比市场已经预期的更强，还是更弱？"}, {"title": "把二维框架当成提问工具", "text": "本页的增长—通胀四象限用于整理经济环境，不会自动给出资产买卖答案。资产价格还取决于估值、政策、供给和持仓。读第一册相关主题时，可以用四象限提出假设，再用具体年份反例检查假设。"}], "chain": ["增长与价格线索", "政策和融资需求", "收益率变化假设"], "example": "设想增长走弱、通胀也走弱。利率债可能获得基本面支持；但若长期债已经很贵，或者融资成本上升，持有体验仍可能不佳。宏观方向正确，交易结果也不一定立即正确。", "pitfall": "把“复苏、过热、滞胀、衰退”当成不可跳过、按固定时长循环的四个阶段。现实可以反复或跨越。", "question": "通胀下降，能直接推出债券价格一定上涨吗？", "answer": "不能。需要同时检查增长、政策、供给、估值与市场预期；通胀只是解释变量之一。", "terms": ["通胀", "预期差", "期限溢价"], "lab": "growth"}, {"id": "b1-3", "book": "b1", "title": "为什么央行利率与长债利率会背离", "deck": "短端看当下的资金，长端还在定价未来。", "sections": [{"title": "先画出三层利率", "text": "第一层是央行工具所传递的政策信号；第二层是金融机构实际融入短期资金的成本；第三层是不同期限债券的市场收益率。制度环境与交易约束决定三层如何传导。第一册公开目录中有对基本利率关系的研究，阅读时应特别留意各类利率的定义。"}, {"title": "长端定价的是一段未来", "text": "长期收益率可以粗略拆为未来短期利率路径的预期与期限溢价。即使今天的短期资金还较紧，如果市场开始预期未来增长放缓、政策转松，长债也可能提前反映。反过来，当天降息也可能早已被计入价格。"}, {"title": "背离是线索，需要继续归因", "text": "观察到短端上行、长端下行，不应先认定某一方“错了”。应检查期限结构是否趋平、市场是否提前交易未来变化，以及长端需求是否有特殊因素。这个方法比用一个利率替代所有利率更可靠。"}], "chain": ["当期政策与融资", "未来短端路径预期", "长端收益率与溢价"], "example": "假设1年期收益率从2.0%到2.3%，10年期从3.0%到2.8%。长短利差从100bp缩窄到50bp。曲线趋平，但这并不能单独证明经济即将衰退。数字仅为教学设定。", "pitfall": "把历史上的央票、存贷款基准利率等工具关系，原样套用到今天的政策框架。比较前应先确认制度时期。", "question": "“短端紧、长端跌”一定是价格矛盾吗？", "answer": "不一定。它可能反映当期融资成本与未来政策预期的差别，也可能来自期限溢价和机构配置需求变化。", "terms": ["收益率曲线", "期限利差", "期限溢价"], "lab": "curve"}, {"id": "b1-4", "book": "b1", "title": "把历史复盘写成可以验证的假设", "deck": "从“事后觉得有道理”，走到“当时知道什么”。", "sections": [{"title": "先锁定信息可得的时间", "text": "历史复盘最容易出现的问题，是把后来公布的数据带回之前的决策。可以用两列记录：交易日当时能看到的事实，以及后来才知道的结果。某月数据在下月发布，就不应成为月初决策的现成理由。"}, {"title": "为每条逻辑写一个反证条件", "text": "例如“需求走弱可能带动收益率下行”，同时写下可能令它失败的条件：通胀突然上行、资金成本抬升、债券供给增加，或价格已提前反映。反证条件不是为了回避判断，而是为了知道何时需要修正。"}, {"title": "从一段行情走到一套复盘模板", "text": "记录经济环境、政策与融资、市场定价、仓位约束和最终结果。再比较不同年份中哪些条件相似，哪些不同。第一册覆盖的年份跨度较长，适合练习跨年份比较；这份模板是本页面补充的方法。"}], "chain": ["当时可得事实", "写下假设与反证", "结果对照与修正"], "example": "假设你在月底读到一份“本月经济明显走弱”的报告。复盘时要进一步标注：依据的数据是哪天公布的？市场在公布前是否已经变化？如果当时没有这些信息，就不能把它算作提前判断的证据。", "pitfall": "用一条事后拼接得很顺的叙事，代替真实的判断记录；或者只选成功案例，不保留失败和无交易的时期。", "question": "为什么一个最终正确的结论，也可能不是一次合格预测？", "answer": "它可能在结果发生之后才提出，或者使用了当时不可得的信息。预测质量要看信息时点、可执行性和预先定义的检验标准。", "terms": ["预期差", "样本外", "信息时点"], "lab": "map"}, {"id": "b2-1", "book": "b2", "title": "货币宽松，不等于信用已经扩张", "deck": "银行体系的钱，与实体部门愿不愿借钱，是两件事。", "sections": [{"title": "先限定“货币”的含义", "text": "在这类分析中，可以把货币条件先理解为银行间资金价格、可获得性和政策操作，而不是看到M2高就直接判定宽松。资金利率下降，通常说明某个层面的融资条件改善，但不代表所有借款人同时获得同样便利。"}, {"title": "信用描述融资如何进入实体", "text": "信用扩张既涉及金融机构愿不愿贷，也涉及企业和居民愿不愿借。贷款、债券融资和政府融资还可能表现不同。观察信用时，需要注明口径、流量或存量、结构与同比基数，而不能把一个总量当成全部答案。"}, {"title": "四种组合比一个“松”字更有用", "text": "货币和信用可以同时偏松、同时偏紧，也可以一个先变、另一个后变。由此产生不同的政策传导和资产定价假设。第二册公开书目信息明确涉及货币与信用的组合分析；实验页将其转成教学情景。"}], "chain": ["银行间融资条件", "信用供给与借款需求", "实体支出与资产价格"], "example": "假设银行间资金成本下降，但企业仍推迟投资、居民仍倾向还款。货币条件可以改善，实体信用却未必同步扩张。此时仅用“放水”二字解释股债方向，会漏掉传导过程。", "pitfall": "把信用扩张等同于信用利差收窄。前者说融资活动，后者说债券相对收益率，两者相关但定义不同。", "question": "资金面变松，为什么贷款需求可能依然偏弱？", "answer": "融资成本只是条件之一，借款人的盈利预期、现金流、负债意愿和抵押约束同样影响需求。", "terms": ["货币条件", "信用扩张", "信用利差"], "lab": "money"}, {"id": "b2-2", "book": "b2", "title": "把供需拆开，才能解释同一宏观环境的不同走势", "deck": "宏观给出背景，机构的资产负债表决定交易如何发生。", "sections": [{"title": "债券也是有买方和卖方的资产", "text": "需求可能来自配置、交易和流动性管理；供给可能来自发行、到期续作以及持有人减仓。讨论供需时，应注明期限、品种与观察窗口。总量看似充足的需求，未必愿意承接某个期限或某类信用风险。"}, {"title": "约束会改变机构的行为", "text": "同一条宏观消息下，有的机构因为负债稳定而增加配置，有的机构却因赎回需要出售资产。融资成本、久期约束、资本占用与流动性需求，都可能使交易结果偏离简单的基本面推导。这里是一般机制解释，并非复述作者的特定三因素定义。"}, {"title": "如何对照第二册阅读", "text": "公开目录列出了供需框架主题，但目前未取得原文，不能据标题重建其完整变量和系数。阅读时可先用本页“谁发行、谁持有、谁融资”的通用问题表整理，再回原书核对作者的具体定义。"}], "chain": ["发行与存量调整", "机构需求和负债约束", "价格与成交承接"], "example": "假设长期债发行增加，同时某类长期资金增配。仅凭“供给多”很难判断收益率方向，还需要比较增量需求、发行节奏、估值补偿和市场已有预期。", "pitfall": "只比较债券发行的绝对规模，不比较到期偿还、期限分布和承接资金的属性。", "question": "为什么“配置需求很强”与“市场价格下跌”能同时发生？", "answer": "配置需求可能集中在其他期限或品种，也可能被短期出售压力、融资收缩或更大的供给变化抵消。", "terms": ["流动性", "久期", "期限溢价"], "lab": "curve"}, {"id": "b2-3", "book": "b2", "title": "利率债与信用债：风险拆成两层读", "deck": "无风险利率下降，信用债也可能亏钱。", "sections": [{"title": "先拆基准，再看利差", "text": "信用债收益率可以粗略分成可比基准收益率与信用利差。基准变动主要体现利率环境，利差还反映违约风险、流动性、税收与供需等差别。比较利差前应匹配期限和债券特征，避免把不同品种硬凑在一起。"}, {"title": "两种变化可能相互抵消", "text": "若基准收益率下降、利差却上升，信用债的总收益率可能不降反升。价格因此可能没有上涨，甚至下跌。所以“看多债券”需要继续细化：看多什么期限、什么资质、承担什么利差风险？"}, {"title": "信用质量需要单独检查", "text": "宏观利率判断无法替代对发行人现金流、偿债来源、债务结构、担保安排与契约条款的研究。第二册的信用类主题可以作为阅读入口；本页着重补足利率与利差的基础区别。"}], "chain": ["可比基准收益率", "叠加信用与流动性补偿", "形成信用债收益率"], "example": "假设基准收益率下行30bp，利差上行80bp，总收益率上行50bp。若修正久期为4，忽略凸性和其他因素，价格影响约为−2%。这是近似价格变化，不含票息及信用事件损失。", "pitfall": "把评级较高理解成没有风险，或用最终回本的期待忽略中间流动性和估值波动。", "question": "基准下行30bp、利差上行80bp，方向上更接近利好还是利空债券价格？", "answer": "总收益率上行50bp，对固定现金流债券的价格通常形成压力；实际结果还取决于现金流和其他风险。", "terms": ["信用利差", "修正久期", "流动性"], "lab": "spread"}, {"id": "b2-4", "book": "b2", "title": "从框架到配置，中间还有估值和风险预算", "deck": "先解释环境，再讨论这份风险值不值得承担。", "sections": [{"title": "宏观状态不是组合指令", "text": "即使判断某种环境对债券较友好，也不能直接推出所有客户都应增加同一种债券。投资期限、现金需求、可承受回撤和已有仓位，决定同一个观点如何表达。宏观判断解决环境问题，组合管理还要解决规模和约束。"}, {"title": "好的方向，可能配上了很贵的价格", "text": "债券收益率已经很低、信用利差已经很薄时，后续有利变化可能部分被计入价格。评价一个配置想法，至少需要把方向、估值、持有收益、波动和退出条件放在一起。"}, {"title": "把书里的问题迁移到顾问工作", "text": "对持有人解释债基波动时，可以依次讲清底层资产是什么、收益来自哪里、什么条件会亏损，以及与用钱时间是否匹配。这是本页面向财富管理场景的延伸，不代表原书提供了客户配置建议。"}], "chain": ["形成环境假设", "检查估值与已有暴露", "匹配期限和风险预算"], "example": "同样看好利率下行，三个月后要用的钱，与五年以上稳定资金，不能只凭同一宏观观点选择相同久期。用钱时点可能比你对利率方向的信心更重要。", "pitfall": "把宏观框架包装成一键选基、固定仓位或客户收益承诺。", "question": "为何方向判断正确，也仍然需要限制仓位？", "answer": "判断可能延迟兑现，中途波动和负债压力可能迫使提前退出；仓位应受损失承受力和流动性需求约束。", "terms": ["风险预算", "久期", "预期差"], "lab": "duration"}, {"id": "b3-1", "book": "b3", "title": "非典型周期：框架为什么需要升级", "deck": "一套解释，能否容纳令它不舒服的证据？", "sections": [{"title": "保留宏观，也给金融条件一个位置", "text": "第三册的公开简介强调，这段债市变化不能只按常见的增长与通胀组合来理解。这里可以提出一个一般问题：金融机构融资与杠杆条件的变化，是否足以在实体数据尚未显著变化时影响价格？"}, {"title": "不同层面可能有不同周期", "text": "实体投资、银行间融资、监管约束和资产交易，不必同时到达拐点。用一个总周期标签覆盖全部层面，容易忽略传导时差。读到“不符合原有解释”的行情时，应先检查变量遗漏、时点和口径。"}, {"title": "升级框架不等于不断加变量", "text": "增加变量有助于解释历史，但过多自由度也会让任何结果都显得有理。有效的升级应当带来可检验的预测、清晰的条件和更好的样本外表现，而不是只让事后叙事更顺。"}], "chain": ["发现旧解释的偏差", "检查金融条件与约束", "定义新假设并检验"], "example": "若通胀不高，但融资成本明显上升，杠杆持仓仍可能受到压力。这个情景说明“低通胀”不是债券上涨的充分条件，而不是说明通胀从此不重要。", "pitfall": "旧框架解释不了一次行情，就宣布它永远失效；或者加入任意多变量直到历史全部能被解释。", "question": "判断一个新框架有价值，应先检查什么？", "answer": "定义是否清楚、信号是否事前可得、是否改善样本外解释与决策，以及在何种条件下会失效。", "terms": ["杠杆", "样本外", "信息时点"], "lab": "money"}, {"id": "b3-2", "book": "b3", "title": "利率、利差、波动率：别把它们揉成一个风险", "deck": "把风险拆开，才知道组合究竟在赚哪份钱。", "sections": [{"title": "利率与利差是两个定价维度", "text": "利率风险体现基准曲线变动带来的价格变化；利差风险体现相对基准的补偿变化。二者方向可能不同。第三册公开简介同时提及这两个维度，本页实验将其拆成两个可独立改变的输入。"}, {"title": "波动率还影响持仓能否坚持", "text": "即使预期平均收益没有变化，波动上升也可能触发风险限额、保证金要求和赎回压力。对于使用杠杆的持仓，路径和波动可能与最终方向同样重要。不过，波动率本身并不是所有普通债券的独立线性收益项。"}, {"title": "用归因代替笼统判断", "text": "复盘时分别列出基准、利差、票息、融资和信用事件。可以用近似分解理解方向，但不要把近似当精确结算；曲线非平行变动、含权条款和价格凸性都会增加误差。"}], "chain": ["拆开基准与利差", "观察波动及持仓约束", "形成风险归因"], "example": "两只债券可能有相似的到期收益率，却有不同的久期、信用资质和流动性。仅比较收益率数字高低，无法判断谁的风险调整后价值更好。", "pitfall": "用“收益率高”替代完整风险归因，或把价格波动、违约损失和流动性折价当成同一种风险。", "question": "波动率上升一定意味着固定现金流债券价格下跌吗？", "answer": "不一定。它主要描述价格变化的不确定性；对含权结构的影响还取决于期权特征，不能一概而论。", "terms": ["信用利差", "波动率", "杠杆"], "lab": "spread"}, {"id": "b3-3", "book": "b3", "title": "30年债：到期很远，价格反应却很近", "deck": "长期限不是拿得更久就自然更安全。", "sections": [{"title": "久期在衡量价格敏感度", "text": "剩余期限说明最后一笔本金何时偿还，久期则综合现金流时点与现值权重。对于普通固定利率债券，低票息、长期限通常意味着更大的利率敏感度。修正久期可用来估计小幅收益率变化下的价格百分比变化。"}, {"title": "凸性解释直线近似的误差", "text": "同一只普通无期权债券，价格与收益率的关系通常是一条弯曲的线。收益率变动较大时，只使用久期的线性近似会产生误差。实验页同时展示现金流重新定价、久期近似和凸性修正，帮助理解三者区别。"}, {"title": "长期趋势与短期承受力分开", "text": "即使相信长期利率存在下行力量，中间的上行波动仍可能带来显著净值回撤。第三册公开简介涉及30年期国债，本页用简化年付息债券解释基础机制；它不是对现实某只国债的定价复刻。"}], "chain": ["更远的现金流", "更大的利率敏感度", "更显著的价格波动"], "example": "在票息与收益率均为3%的简化设定下，剩余10年债的修正久期约8.53，30年债约19.60。利率上行100bp时，重新定价约下跌8.11%与17.29%；大幅变化应优先看重新定价。", "pitfall": "把“国债信用风险较低”理解为“国债市值不会下跌”，或把剩余30年直接当成修正久期30。", "question": "期限与久期为什么不完全相同？", "answer": "期限只描述最终到期时点；久期还取决于中间票息、收益率和各笔现金流的现值权重。", "terms": ["久期", "修正久期", "凸性", "DV01"], "lab": "duration"}, {"id": "b3-4", "book": "b3", "title": "拐点研究：多做反证，少找神奇指标", "deck": "有用的信号，应当经得起数据时点和失败案例的检查。", "sections": [{"title": "领先关系可能是样本偶然", "text": "某指标过去几次领先收益率，不代表它未来仍会领先。经济制度、政策工具、机构结构和统计口径变化，都可能让关系改变。检验时应保留失效的时期，并关注发布时点，而非只画一张平滑后的图。"}, {"title": "区分水平、变化与加速度", "text": "收益率水平、收益率的变化、变化速度的变化，是三个不同的问题。类似地，信用总量增长与信用增量改善并不相同。图形看起来相近，可能只是共同趋势；需要明确指标转换方式，再讨论经济含义。"}, {"title": "把结论写成带条件的场景", "text": "可以记录基础场景、触发条件、反证信号和复核日期。页面的练习问题只是帮助形成思维习惯，尚未接入实时数据，也不会对今天的市场做拐点判断。"}], "chain": ["检查信号定义与时点", "保留失败样本", "跟踪条件与反证"], "example": "如果你从十几个指标里挑出历史拟合最好的一个，再用同一段历史证明它有效，就容易高估效果。更合理的做法是锁定方法，拿未参与选择的时期检验。", "pitfall": "把高频当领先，把相关当因果，把回测最优当成未来可靠。", "question": "为什么高频数据不一定比月度数据更领先？", "answer": "高频只说明更新更频繁，不代表它在经济机制上先发生；它也可能与目标变量同步或更滞后。", "terms": ["样本外", "信息时点", "前瞻指标"], "lab": "map"}, {"id": "b4-1", "book": "b4", "title": "信贷与库存：读出两个周期之间的时差", "deck": "先确认融资流向，再检查它有没有变成真实支出。", "sections": [{"title": "融资改善与需求兑现可能不同步", "text": "融资进入企业后，可能用于扩产、补库存、偿还旧债或保留现金。这些用途对当期需求的影响不同。讨论信贷与库存的联系，至少要分别观察融资条件、借款用途、生产销售和库存变化。"}, {"title": "主动与被动库存要结合销售看", "text": "库存增加可能来自企业看好需求主动备货，也可能来自销售不及预期的被动积压。仅有库存增速，无法把两种状态区分开。可以同时问：订单和销售怎样变、生产如何调整、资金被占用了多少？"}, {"title": "对照原书，而不虚构作者公式", "text": "第四册公开目录明确列有信贷库存周期主题，但没有取得全文和原始模型。本页只给出一般机制的阅读问题，不会把自行设计的指标、阈值或公式称为作者的方法。"}], "chain": ["融资条件与融资用途", "生产销售与补库行为", "库存和资金占用反馈"], "example": "两家公司都增加借款：一家用来扩产备货，另一家用来偿还旧债。贷款总量的变化相似，带来的新增需求却可能很不同。阅读信用数据时，结构通常值得与总量一起看。", "pitfall": "把库存上升自动解释为复苏，或把新增融资全部视为新增投资。", "question": "看到库存增加，下一步最该补充观察什么？", "answer": "订单、销售、生产与融资用途，以区分主动备货和被动积压，并检查库存占用资金的程度。", "terms": ["信用扩张", "库存周期", "前瞻指标"], "lab": "money"}, {"id": "b4-2", "book": "b4", "title": "跨资产验证：让一个判断接受多种证据检验", "deck": "股、债、商品可能提供不同角度，也可能共用同一噪声。", "sections": [{"title": "价格信号也需要解释", "text": "股票价格可能反映盈利、折现率或风险偏好；债券价格可能反映利率和信用；商品还受供给、库存及汇率影响。三个市场同向变化，不代表它们在表达同一个宏观故事。"}, {"title": "先提出叙事，再列反例", "text": "例如“需求改善”这一假设，可继续检查订单、融资和利润等线索是否呼应。如果只有某个商品上涨，也可能是供给扰动。跨资产比较的价值，是发现原来解释遗漏了什么，而不是用价格互相证明价格。"}, {"title": "共识越强，越要检查独立性", "text": "多个资产可能同时受同一个融资或情绪因素驱动。把高度相关的信号当成多份独立证据，会虚增信心。第四册公开目录涉及多资产合成与风险偏好，本页用这组问题补充阅读。"}], "chain": ["提出共同经济假设", "比较不同资产的解释", "检查独立证据与反例"], "example": "假设股票与长债一起上涨。可能存在折现率下降的共同因素，也可能同时出现不同的资金需求。仅凭“股债双牛”四个字，无法判断经济是在加速还是走弱。", "pitfall": "把任何多资产同涨同跌都归因于流动性，或者忽略各资产自身的供给与估值。", "question": "三个高度相关的指标，能算三份完全独立的证据吗？", "answer": "不能。它们可能只是同一个底层变量的不同表现，应该检查信息重叠和共同驱动因素。", "terms": ["风险偏好", "预期差", "信用利差"], "lab": "map"}, {"id": "b4-3", "book": "b4", "title": "股债收益差：先把比较口径写在前面", "deck": "股息率、盈利收益率和债券收益率，分别承诺了什么？", "sections": [{"title": "同样叫收益率，性质可能不同", "text": "债券到期收益率是价格与约定现金流的折现关系；股息率是分红与股价之比；市盈率倒数是盈利与市值之比。股票盈利不等于全部分红，也没有合同承诺保持不变，三者不能被当成同类的保证收益。"}, {"title": "差值方向也必须写清", "text": "采用“债券收益率减股息率”，和采用“盈利收益率减债券收益率”，数值方向不同、含义也不同。第四册公开目录分别列有利率与股息率、利率与市盈率倒数之差；本页计算只展示口径差异，不称为作者配置模型。"}, {"title": "相对估值还需要其他维度", "text": "盈利周期、分红稳定性、成长、风险溢价和指数构成，都会影响比较。历史区间也不是天然的买卖阈值。因此适合把收益差当成估值问题的起点，再结合风险预算和投资期限讨论。"}], "chain": ["定义债与股的收益口径", "写清相减方向", "检查盈利与风险差异"], "example": "假设股息率3.5%、市盈率15倍、债券收益率2.5%。债券收益率减股息率为−1.0个百分点；债券收益率减市盈率倒数约为−4.17个百分点。两个数回答不同问题，不能互换。", "pitfall": "把市盈率倒数当成持有人每年可以收到的现金，或把差值越大自动解释为确定性套利。", "question": "15倍市盈率的倒数约6.67%，意味着每年保证获得6.67%吗？", "answer": "不意味着。它是当期或预测盈利相对价格的比例，盈利可变，也不一定全部分配给持有人。", "terms": ["股息率", "盈利收益率", "风险偏好"], "lab": "equity"}, {"id": "b4-4", "book": "b4", "title": "前瞻指标与流动性：把最后两个模糊词讲清", "deck": "一张周更观察表，要同时写清含义、时点与边界。", "sections": [{"title": "高频、同步与领先是不同标签", "text": "一个每日更新的指标，也可能只是在反映当天已经发生的情况。要验证领先性，需要明确它领先哪个变量、多久、在什么时期有效，并使用当时可得的数据版本。第四册公开目录讨论了高频与同步的区别，适合围绕这一问题阅读。"}, {"title": "流动性至少有多个层面", "text": "银行间融资是否容易、某只债券是否容易成交、股票市场承接是否充分、实体企业是否容易融资，谈的是不同问题。一种层面的改善不保证传到另一种层面。每次使用“流动性”一词，都补上对象、价格、数量和期限。"}, {"title": "把四册变成你的观察流程", "text": "先记录增长与通胀，再记录货币与信用，然后检查曲线、利差、波动与估值，最后写出跨资产证据和反证。这是本页综合设计的阅读后工作流，不是从原书还原的交易系统。"}], "chain": ["明确对象与发布时点", "区分融资和成交条件", "组织多层观察与反证"], "example": "“银行间资金便宜”不等于“某只信用债容易卖出”。如果买卖报价稀少、价差很大，市场流动性仍可能较差。顾问解释产品波动时，应明确说的是哪一种流动性。", "pitfall": "用一句“资金多了”同时解释所有资产和实体融资；或者把本页面的教学框架当成接入实时数据的市场系统。", "question": "每日更新的价格指标，天然就是经济领先指标吗？", "answer": "不是。需要验证经济机制、发布时间、历史稳定性和样本外表现，更新频率本身不能证明领先性。", "terms": ["前瞻指标", "流动性", "信息时点"], "lab": "map"}], "glossary": {"票息": "债券合同约定的付息比例。固定票息通常不随二级市场交易价格改变。", "到期收益率": "让约定未来现金流的现值等于当前全价的折现率；实际持有回报仍受违约、卖出价格和再投资影响。", "基点": "1bp＝0.01个百分点＝0.0001。收益率从3%到3.5%是上升50bp，不是上升0.5bp。", "通胀": "一般价格水平的上涨。观察时要区分不同价格指标、同比与环比，以及需求和供给原因。", "预期差": "实际结果相对于事先预期的差别。数据好坏与市场反应方向不一定一一对应。", "期限溢价": "持有较长期债券，相对预期短期利率路径所要求的额外补偿；它不是直接可观测的单一报价。", "收益率曲线": "同一观察时点、可比信用和其他特征下，不同期限债券收益率之间的关系。", "期限利差": "长端收益率减短端收益率。比较时应保持品种、税收和信用特征可比。", "货币条件": "本页主要指银行间融资价格、可得性和政策操作等条件，不等同于单一货币总量。", "信用扩张": "融资活动的增加或改善。应明确口径、流量或存量和融资结构；它不等同于信用利差变化。", "信用利差": "某债券相对于可比基准的收益率差，可能包含信用、流动性、税收与供需等补偿。", "久期": "现金流时点按其现值加权的平均时间，常称麦考利久期。本页年付息模型中，修正久期＝麦考利久期÷(1＋收益率)。", "修正久期": "价格对收益率小幅变动的敏感度。近似关系为ΔP/P≈−Dmod×Δy，收益率须用小数表示。", "凸性": "价格—收益率曲线弯曲程度的度量。二阶近似加入½×凸性×(Δy)²；含权债券可能有不同特征。", "DV01": "收益率变动1bp对应的价格金额变化。小幅近似为价格×修正久期×0.0001；本页按面值100元计算。", "流动性": "需要指明对象：融资可得性、资产成交难易、市场承接或实体融资条件，不同层面不能互相替代。", "杠杆": "使用融资放大资产持仓。它同时放大价格变化的影响，并增加融资续作和资金成本风险。", "波动率": "收益或价格变化的离散程度。高波动不自动等于负收益，但会影响风险预算和持仓约束。", "风险预算": "在承受能力和业务约束内，为各类风险分配可接受的损失或波动空间。", "样本外": "没有参与模型选择和参数调整的数据区间，用于检验方法能否适用于未见时期。", "信息时点": "信息实际发布并可被使用的时间。不同于其统计所属时间，也不同于后来修订的版本。", "库存周期": "库存、销售和生产之间的动态变化；库存增加既可能是主动备货，也可能是被动积压。", "前瞻指标": "在明确目标、时距和检验标准下，对未来变化提供信息的指标。高频不等于领先。", "股息率": "每股分红与股价之比，需说明使用过去分红还是预测分红；分红可能变化。", "盈利收益率": "市盈率的倒数，即每股盈利相对股价的比例；当盈利为负或接近零时需要特别处理。", "风险偏好": "承担不确定收益和损失的意愿。它不能仅凭某一资产当天的涨跌被完整观测。"}, "sources": [{"name": "第一册书目与公开目录", "url": "https://www.megbook.com.tw/mall/detail.jsp?proID=1770049", "kind": "书目核实", "scope": "核对作者、ISBN、出版年与利率关系等主题；未取得全书正文。"}, {"name": "第二册公开书目信息", "url": "https://www.sanmin.com.tw/product/index/006973817", "kind": "书目核实", "scope": "核对2011—2015年范围与货币、信用、供需等主题。"}, {"name": "第三册出版机构书城简介", "url": "https://www.zcycjy.com/readBooks?bookCde=2019071919&switChover=1", "kind": "出版机构页面", "scope": "核对2016—2018年范围，以及非典型周期、利差、超长债等公开主题。"}, {"name": "第四册公开目录与作者序言", "url": "https://www.sanmin.com.tw/product/index/012815827", "kind": "公开目录", "scope": "核对2019—2022年范围及信贷库存、股债收益差、前瞻指标、流动性等主题。"}, {"name": "对外经贸大学图书馆：第二册书目", "url": "https://opac.uibe.edu.cn/opac/book/eb01f5700745684929b16c3a360efa5d", "kind": "馆藏元数据", "scope": "交叉核对第二册ISBN与出版年；本次搜索取得书目摘要，详情页读取超时。"}, {"name": "美国SEC：利率风险投资者教育材料", "url": "https://www.sec.gov/investor/alerts/ib_interestraterisk.pdf", "kind": "基础机制", "scope": "支持固定利率债券价格与市场收益率反向变动的说明。计算器采用本页实现的简化现金流模型。"}], "checked": "2026-11-19"};
const KEY='clair-dong-reading-v1';
const $=s=>document.querySelector(s);
const e=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let storageAvailable=true;
let state={done:[],marks:[],notes:{},last:'b1-1',font:18,dark:false};
try{const v=JSON.parse(localStorage.getItem(KEY)||'null');if(v&&typeof v==='object'){state={...state,...v,done:Array.isArray(v.done)?v.done:[],marks:Array.isArray(v.marks)?v.marks:[],notes:v.notes&&typeof v.notes==='object'&&!Array.isArray(v.notes)?v.notes:{}}}}catch{storageAvailable=false}
state.done=[...new Set(state.done.filter(id=>DATA.units.some(u=>u.id===id)))];state.marks=[...new Set(state.marks.filter(id=>DATA.units.some(u=>u.id===id)))];
if(![16,18,20,22].includes(state.font))state.font=18;
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state));return true}catch{storageAvailable=false;return false}};
const go=hash=>{if(location.hash==='#'+hash)render();else location.hash=hash};
let current='home',lastFocus=null,toastTimer=0,quad='mw-cw';
const bookById=id=>DATA.books.find(b=>b.id===id);
const unitById=id=>DATA.units.find(u=>u.id===id);
const pct=()=>Math.round(state.done.length/DATA.units.length*100);
function showToast(t){$('#toast').textContent=t;$('#toast').hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('#toast').hidden=true,2400)}
function applyPrefs(){document.body.classList.toggle('dark',!!state.dark);document.documentElement.style.setProperty('--body-size',state.font+'px');$('#fontLabel').textContent=state.font;$('#themeToggle').textContent=state.dark?'浅色':'深色'}
function sidebar(){const b=current.startsWith('read/')?unitById(current.split('/')[1])?.book:current.startsWith('book/')?current.split('/')[1]:'';
 $('#sidebar').innerHTML=`<div class="brand"><div class="brand-symbol">阅</div><div><strong>投资交易笔记</strong><small>DONG DEZHI</small></div></div>
 <button class="nav-item ${current==='home'?'active':''}" data-go="home"><span class="nav-icon">▦</span>四册总览</button>
 <button class="nav-item ${current==='map'?'active':''}" data-go="map"><span class="nav-icon">◇</span>框架图谱</button>
 <button class="nav-item ${current.startsWith('lab/')?'active':''}" data-go="lab/money"><span class="nav-icon">◈</span>交互实验室</button>
 <button class="nav-item ${current==='timeline'?'active':''}" data-go="timeline"><span class="nav-icon">◷</span>历史阅读路线</button>
 <div class="side-label">书架 · 主题导读</div><div class="book-nav">${DATA.books.map(x=>`<button class="nav-item ${b===x.id?'selected':''}" style="--book:${x.color}" data-go="book/${x.id}"><span>${e(x.suffix)} · ${e(x.years)}<span class="sub">${e(x.concept)}</span></span></button>`).join('')}</div>
 <div class="side-label">我的阅读</div>
 <button class="nav-item ${current==='glossary'?'active':''}" data-go="glossary"><span class="nav-icon">Aa</span>术语索引</button>
 <button class="nav-item ${current==='notes'?'active':''}" data-go="notes"><span class="nav-icon">▤</span>笔记与书签</button>
 <button class="nav-item ${current==='sources'?'active':''}" data-go="sources"><span class="nav-icon">⊙</span>资料与阅读说明</button>
 <div class="side-progress"><div class="progress-label"><span>已读 ${state.done.length} / ${DATA.units.length} 单元</span><span>${pct()}%</span></div><div class="progress-track"><div class="progress-fill" style="width:${pct()}%"></div></div><div class="side-foot">原创主题导览 · 非原书全文<br>笔记与进度保存在当前浏览器</div></div>`;
}
function footer(){return `<footer class="footer"><span>董德志《投资交易笔记》四册 · 可视化阅读导览<br>公开书目核实于 ${DATA.checked}；讲解、图示与教学情景由本页原创整理。</span><button class="button" data-go="sources">查看资料与范围</button></footer>`}
function home(){return `<section class="hero"><div><div class="eyebrow">四册 · 16个阅读单元 · ${Object.keys(DATA.glossary).length}个术语</div><h1>董德志<br>投资交易笔记<span>把债券市场，读成一套逻辑。</span></h1><p class="hero-copy">从增长与通胀，到货币与信用，再到利率、利差和多资产验证。沿着四册的公开主题线索，把抽象概念拆成能读、能看、能操作的图解。</p><div class="actions"><button class="button primary" data-go="read/${unitById(state.last)?e(state.last):'b1-1'}">${state.done.length||Object.keys(state.notes).length?'继续阅读':'开始阅读'}</button><button class="button" data-go="map">看框架图谱</button></div><p class="source-note">当前为基于公开目录与简介的原创导读，未包含原书全文。<br>图表中的计算与情景均已标明口径，不作为作者原文或实时行情。</p></div><div class="hero-visual"><div class="small">理解债市的四组问题</div><div class="lens-grid"><div class="lens"><small>实体经济</small><strong>增长 × 通胀</strong></div><div class="lens"><small>金融条件</small><strong>货币 × 信用</strong></div><div class="lens"><small>交易风险</small><strong>利率 × 利差</strong></div><div class="lens"><small>信息校验</small><strong>多资产 × 时点</strong></div></div><p style="font-size:13px;color:#a7b8d2;margin:22px 0 0">这四组问题用于组织本页导读，不代表原书的完整模型。</p></div></section>
 <div class="section-title"><h2>沿着四册，逐层展开</h2><span>可直接选择任意一册</span></div><div class="books-grid">${DATA.books.map(b=>`<button class="book-card" data-go="book/${b.id}" style="--book:${b.color}"><div class="cover"><div class="cover-label">${e(b.suffix)} · 主题索引</div><div class="cover-name">投资交易笔记${b.id==='b1'?'':b.id==='b2'?'（续）':b.id==='b3'?'（三）':'（四）'}</div><div class="cover-year">${e(b.years)}</div></div><div class="book-info"><h3>${e(b.concept)}</h3><p>${e(b.summary)}</p><small>${DATA.units.filter(u=>u.book===b.id&&state.done.includes(u.id)).length} / 4 单元已读 · 进入阅读</small></div></button>`).join('')}</div>
 <div class="section-title"><h2>让概念，发生在眼前</h2><span>全部为教学情景</span></div><div class="split-grid"><section class="panel"><h3>利率动一点，债券价格动多少？</h3><p>改变票息、剩余期限和收益率冲击，对照现金流重新定价、久期近似和凸性修正。直观看清30年债的价格敏感度。</p><button class="button" data-go="lab/duration">打开债券价格实验</button></section><section class="panel"><h3>建议的阅读顺序</h3><div class="path-steps"><div class="path-step"><i>1</i><p>先读价格与收益率，建立最基础的方向感。</p></div><div class="path-step"><i>2</i><p>再分开增长、通胀、货币与信用。</p></div><div class="path-step"><i>3</i><p>带着久期、利差和反证条件，回看历史。</p></div></div></section></div>`}
function bookView(id){const b=bookById(id);if(!b)return missing();return `<div class="page-head book-head" style="--book:${b.color}"><div class="eyebrow">${e(b.suffix)} · ${e(b.years)}年中国债券市场研究回眸</div><h1>${e(b.name)}</h1><p>${e(b.summary)}</p><div class="metadata"><span>作者 董德志</span><span>经济科学出版社 · ${b.published}年</span><span>ISBN ${b.isbn}</span></div><div class="pills">${b.themes.map(t=>`<span class="pill">${e(t)}</span>`).join('')}</div></div><section class="panel"><strong>这一册，先抓住一个问题</strong><p style="margin:8px 0 10px;font-size:21px;color:var(--ink)">${e(b.concept)}</p><div class="quiet">下方为本页编排的4个原创阅读单元，按公开主题延伸讲解；单元名称、顺序与内容不是原书章节复现。<a href="${e(b.source)}" target="_blank" rel="noopener noreferrer">核对公开书目</a></div></section><div class="unit-list">${DATA.units.filter(u=>u.book===id).map((u,i)=>`<button class="unit-card" data-go="read/${u.id}"><div class="quiet">阅读单元 ${i+1} · ${state.done.includes(u.id)?'已读':'未读'}</div><h3>${e(u.title)}</h3><p>${e(u.deck)}</p><small>约 ${readingMinutes(u)} 分钟 · ${e(u.terms.slice(0,2).join(' / '))}</small></button>`).join('')}</div>`}
function readingMinutes(u){return Math.max(3,Math.ceil((JSON.stringify(u).length)/300))}
function lessonView(id){const u=unitById(id);if(!u)return missing();state.last=id;save();const b=bookById(u.book),n=DATA.units.indexOf(u),siblings=DATA.units.filter(x=>x.book===u.book);return `<div class="read-layout"><article class="reading"><div class="eyebrow">${e(b.suffix)} · 原创阅读单元 ${siblings.indexOf(u)+1} / 4</div><h1 class="article-title">${e(u.title)}</h1><p class="deck">${e(u.deck)}</p><div class="article-meta"><span>${e(b.years)} · 公开主题延伸</span><span>·</span><span>约${readingMinutes(u)}分钟</span><span>·</span><a href="${e(b.source)}" target="_blank" rel="noopener noreferrer">原书书目与主题来源</a></div><div class="article-body">${u.sections.map((s,i)=>`<h2 id="section-${i}">${e(s.title)}</h2><p>${e(s.text)}</p>${i===0?`<div class="causal-flow">${u.chain.map(c=>`<div>${e(c)}</div>`).join('')}</div><div class="causal-caption">概念关系示意 · 不是确定性的买卖规则</div>`:''}`).join('')}<div class="callout"><strong>换一个具体例子</strong><p>${e(u.example)}</p></div><div class="callout amber"><strong>最容易混淆的地方</strong><p>${e(u.pitfall)}</p></div><button class="button" data-go="${u.lab==='map'?'map':'lab/'+u.lab}">打开对应交互图解</button><div class="quiz"><h2>停一下，检查是否读懂</h2><p>${e(u.question)}</p><details><summary>展开参考解释</summary><div>${e(u.answer)}</div></details></div></div><div class="lesson-actions"><button class="button primary" data-done="${u.id}" aria-pressed="${state.done.includes(id)}">${state.done.includes(id)?'已读 · 点击撤销':'标记本单元已读'}</button><div class="lesson-nav">${n?`<button class="button" data-go="read/${DATA.units[n-1].id}">上一单元</button>`:''}${n<DATA.units.length-1?`<button class="button" data-go="read/${DATA.units[n+1].id}">下一单元</button>`:`<button class="button" data-go="notes">回看我的笔记</button>`}</div></div></article><aside class="read-aside"><section class="aside-box"><h3>本册阅读单元</h3>${siblings.map(x=>`<button class="toc-item ${x.id===id?'current':''}" data-go="read/${x.id}">${state.done.includes(x.id)?'✓ ':''}${e(x.title)}</button>`).join('')}<hr style="border:0;border-top:1px solid var(--line);margin:17px 0"><h3>本单元提纲</h3>${u.sections.map((s,i)=>`<button class="toc-item" data-scroll="section-${i}">${e(s.title)}</button>`).join('')}</section><section class="aside-box"><h3>顺手查一个术语</h3><div class="terms-list">${u.terms.map(t=>`<button data-term="${e(t)}">${e(t)}</button>`).join('')}</div></section><section class="aside-box"><h3>留一条自己的理解</h3><textarea id="lessonNote" data-unit="${u.id}" aria-label="本单元阅读笔记" placeholder="记一个疑问、例子，或能用于工作的想法…">${e(state.notes[id]||'')}</textarea><div class="saved-state" id="noteStatus">${storageAvailable?'自动保存在当前浏览器':'浏览器存储不可用，离开后可能丢失'}</div><button class="button ${state.marks.includes(id)?'active':''}" style="width:100%;margin-top:13px" data-mark="${id}" aria-pressed="${state.marks.includes(id)}">${state.marks.includes(id)?'已加入书签':'加入书签'}</button></section></aside></div>`}
function mapView(){const cards=[['实体经济','增长与通胀',['增长与价格变化','融资需求与政策反应','利率环境假设'],'观察实际增长与价格，区分水平、边际变化和预期差。单一宏观象限不能决定所有资产方向。','growth','b1-2'],['金融条件','货币与信用',['资金价格和可获得性','信用供给与借款意愿','实体支出与资产配置'],'把金融机构之间的融资，与企业居民的信用活动拆开；传导可能有时差，也可能停滞。','money','b2-1'],['交易风险','利率与利差',['可比基准收益率','信用与流动性补偿','总收益率与价格风险'],'分别归因利率和利差，再检查久期、波动、融资与持有约束。','spread','b3-2'],['信息校验','多资产与前瞻指标',['提出可检验的解释','寻找独立证据与反例','检查时点和样本外表现'],'价格与数据应互相提问。多个相关信号不一定是独立证据，高频也不天然领先。','equity','b4-4']];return `<div class="page-head"><div class="eyebrow">Framework atlas</div><h1>四组问题，拼出阅读地图</h1><p>这张图将四册公开主题重新组织为学习路径。每条线都代表需要检验的机制，现实中会受到估值、供需、制度与持仓约束影响。</p></div><div class="map-grid">${cards.map(([tag,title,chain,text,lab,u])=>`<section class="map-card"><div class="eyebrow">${tag}</div><h2>${title}</h2><div class="causal-flow">${chain.map(x=>`<div>${x}</div>`).join('')}</div><p>${text}</p><div class="actions" style="margin-bottom:0"><button class="button" data-go="read/${u}">阅读相关单元</button><button class="button" data-go="lab/${lab}">打开图解</button></div></section>`).join('')}</div><section class="panel" style="margin-top:22px"><h3>落到一份观察记录</h3><div class="table-wrap"><table><thead><tr><th>问题</th><th>应记录的内容</th><th>容易漏掉的检验</th></tr></thead><tbody><tr><td>环境怎样变？</td><td>增长、通胀、货币、信用的方向与口径</td><td>水平还是变化？是否已被市场预期？</td></tr><tr><td>风险来自哪里？</td><td>久期、利差、融资、波动和流动性</td><td>价格风险是否与用钱期限匹配？</td></tr><tr><td>何时需要修正？</td><td>反证条件、信息发布时间与复核日期</td><td>是否使用了事后数据？有没有失败样本？</td></tr></tbody></table></div></section>`}
function timelineView(){const prompts=[['比较多个年份，建立利率关系的基础坐标。','同样的增长方向，遇到不同通胀和政策环境，收益率路径会不会不同？'],['把金融条件加入历史解释。','当货币条件和实体信用背离时，原有的增长—通胀解释漏掉了什么？'],['用非典型阶段检验框架。','如果通胀不高，债券为什么仍可能承压？融资和杠杆约束如何传导？'],['扩展到信贷库存和跨资产证据。','同一个流动性判断，能否同时解释资金市场、债券成交与实体融资？']];return `<div class="page-head"><div class="eyebrow">Reading through time</div><h1>把21年的复盘，读成四段问题</h1><p>时间带对应四册覆盖的2002—2022年。这里呈现阅读范围和复盘问题，不绘制未经取得的历史收益率，也不把单个年份压缩成固定投资结论。</p></div><div class="timeline-bar" aria-label="四册覆盖年份比例">${DATA.books.map((b,i)=>`<span style="--book:${b.color};flex:${[9,5,3,4][i]}" title="${b.years}"></span>`).join('')}</div>${DATA.books.map((b,i)=>`<section class="timeline-entry" style="--book:${b.color}"><div class="timeline-year">${b.years}</div><div class="timeline-content"><div class="eyebrow">${b.suffix} · 出版于${b.published}年</div><h3>${b.concept}</h3><p>${prompts[i][0]}</p><div class="callout"><strong>带着这个问题回看历史</strong><p>${prompts[i][1]}</p></div><button class="button" data-go="book/${b.id}">进入本册导读</button></div></section>`).join('')}<p class="lab-note">时间带长度仅表示覆盖年份数量，不表示收益、利率水平或市场涨跌幅。</p>`}
const LABS=[['money','货币 × 信用'],['growth','增长 × 通胀'],['duration','债券价格与久期'],['spread','利率 × 利差'],['curve','收益率曲线'],['equity','股债收益口径']];
function labView(which){if(!LABS.some(x=>x[0]===which))which='money';return `<div class="page-head"><div class="eyebrow">Interactive learning lab</div><h1>动手改一个条件，看看逻辑怎样变</h1><p>所有情景与参数都是教学设定。它们展示概念和计算关系，没有接入实时行情，也不是回测或交易信号。</p></div><div class="lab-tabs" role="tablist" aria-label="选择交互实验">${LABS.map(([id,t])=>`<button role="tab" aria-selected="${id===which}" class="${id===which?'active':''}" data-go="lab/${id}">${t}</button>`).join('')}</div><section id="labContent">${which==='money'||which==='growth'?quadrantLab(which):which==='duration'?durationLab():which==='spread'?spreadLab():which==='curve'?curveLab():equityLab()}</section>`}
const MONEY=[['mw-cw','货币偏松 · 信用偏弱','传导仍在路上','银行间融资条件改善，但借款意愿或信用供给尚未明显跟进。','利率债可能得到资金与偏弱需求的支持。','信用资质仍需独立检查；股票不能只凭资金宽松推断上涨。'],['mw-cs','货币偏松 · 信用偏强','观察需求兑现','融资条件改善，信用活动也在增强，需要继续看融资是否转成支出。','风险资产可能获得需求预期支持，但估值同样重要。','债券短期可能受资金支持，中期又可能面对增长和供给压力。'],['mt-cw','货币偏紧 · 信用偏弱','先检查持仓约束','融资成本或可得性承压，实体融资又偏弱，两个层面共同需要关注。','杠杆与再融资约束可能主导短期交易。','信用与流动性风险可能较突出，不能因增长弱就忽略资金压力。'],['mt-cs','货币偏紧 · 信用偏强','需求与资金争用','实体融资需求较强，同时银行间融资条件偏紧，需分辨政策和资金来源。','利率债可能面临融资和需求两方面压力。','信用强不代表每个发行人安全，也不代表风险资产一定上涨。']];
const GROWTH=[['mw-cw','增长走弱 · 通胀走弱','需求降温的假设','增长和价格线索同时偏弱，但仍要区分需求不足与供给变化。','利率债可能获得基本面支持。','政策传导、估值和供给可改变实际价格路径。'],['mw-cs','增长走强 · 通胀走弱','复苏的一种组合','实际活动改善，而价格压力尚未同步增强。','部分风险资产可能受益于盈利预期改善。','低通胀并不保证利率债上行；融资需求和预期变化同样重要。'],['mt-cw','增长走弱 · 通胀走强','增长与价格背离','价格压力上升，但实际活动走弱，需要判断供给冲击与持续性。','不同资产可能受到互相冲突的驱动。','不能把单一商品上涨推断为全面需求繁荣。'],['mt-cs','增长走强 · 通胀走强','需求与价格同向','实际活动和物价压力同时增强，政策反应值得重点观察。','名义利率可能承受上行压力。','市场若已充分定价或供给结构不同，资产方向仍可能偏离直觉。']];
function quadrantLab(type){const rows=type==='money'?MONEY:GROWTH;if(!rows.some(x=>x[0]===quad))quad=rows[0][0];return `<div class="lab-layout"><div><div class="quadrant">${rows.map(x=>`<button class="${x[0]===quad?'active':''}" data-quad="${x[0]}" data-quadtype="${type}" aria-pressed="${x[0]===quad}"><em>${type==='money'?'金融条件的两条轴':'经济线索的两条轴'}</em><strong>${x[1]}</strong><span>${x[2]}</span></button>`).join('')}</div><p class="lab-note">点击任一象限阅读解释。各象限不代表按固定顺序循环，也不代表确定性的资产排序。</p></div><div class="lab-explain" id="quadDetail">${quadDetail(rows.find(x=>x[0]===quad),type)}</div></div>`}
function quadDetail(x,type){return `<div class="eyebrow">当前情景</div><h3>${x[2]}</h3><p>${x[3]}</p><ul><li>${x[4]}</li><li>${x[5]}</li></ul><div class="callout"><strong>${type==='money'?'先把两个定义分开':'先把三个问题问清'}</strong><p>${type==='money'?'“货币”主要观察银行间融资条件；“信用”观察融资活动和借款需求。信用扩张与信用利差是不同概念。':'增长是水平还是边际变化？通胀来自需求还是供给？相对于市场预期又怎样？'}</p></div><button class="button" data-go="read/${type==='money'?'b2-1':'b1-2'}">回到相关导读</button>`}
function control(id,label,value,min,max,step,unit){return `<div class="control"><label for="${id}">${label}<output id="${id}Out">${value}${unit}</output></label><input id="${id}" type="range" value="${value}" min="${min}" max="${max}" step="${step}" data-range="true"></div>`}
function durationLab(){return `<div class="controls">${control('maturity','剩余期限',10,1,30,1,'年')}${control('coupon','年票息',3,0,8,.25,'%')}${control('baseYield','初始收益率',3,.5,7,.25,'%')}${control('shock','收益率冲击',50,-150,150,5,'bp')}</div><div id="durationResult"></div>`}
function bondMetrics(n,coupon,y){const c=coupon/100,r=y/100;let price=0,weighted=0,second=0;for(let t=1;t<=n;t++){const cash=100*c+(t===n?100:0),pv=cash/Math.pow(1+r,t);price+=pv;weighted+=t*pv;second+=t*(t+1)*cash/Math.pow(1+r,t+2)}const macaulay=weighted/price,modified=macaulay/(1+r);return{price,macaulay,modified,convexity:second/price,dv01:price*modified*.0001}}
const fmt=(n,d=2)=>Number(n).toFixed(d),signed=(n,d=2)=>(n>0?'+':'')+fmt(n,d);
function svgLine(points,x,y){return points.map((p,i)=>(i?'L':'M')+x(p[0]).toFixed(2)+','+y(p[1]).toFixed(2)).join(' ')}
function drawDuration(){const n=+$('#maturity').value,c=+$('#coupon').value,y0=+$('#baseYield').value,bps=+$('#shock').value,dy=bps/10000;const base=bondMetrics(n,c,y0),next=bondMetrics(n,c,y0+bps/100),exact=(next.price/base.price-1)*100,linear=-base.modified*dy*100,conv=linear+.5*base.convexity*dy*dy*100;const terms=[3,10,30],colors=['#b87931','#3269c4','#8c67bd'];const xmin=Math.min(0,y0-1.75),xmax=Math.max(6,y0+1.75),samples=terms.map(t=>Array.from({length:81},(_,i)=>{const r=xmin+(xmax-xmin)*i/80;return[r,(bondMetrics(t,c,r).price/bondMetrics(t,c,y0).price-1)*100]}));let lo=Math.floor(Math.min(...samples.flat().map(p=>p[1]))/10)*10,hi=Math.ceil(Math.max(...samples.flat().map(p=>p[1]))/10)*10;if(lo===hi)hi=lo+10;const W=800,H=340,L=65,R=24,T=20,B=52,x=v=>L+(v-xmin)/(xmax-xmin)*(W-L-R),py=v=>T+(hi-v)/(hi-lo)*(H-T-B);const grid=Array.from({length:5},(_,i)=>{const v=lo+(hi-lo)*i/4;return `<line x1="${L}" y1="${py(v)}" x2="${W-R}" y2="${py(v)}" stroke="var(--line)"/><text x="${L-12}" y="${py(v)+5}" text-anchor="end">${fmt(v,0)}%</text>`}).join('');const ticks=Array.from({length:5},(_,i)=>{const v=xmin+(xmax-xmin)*i/4;return `<text x="${x(v)}" y="${H-27}" text-anchor="middle">${fmt(v,1)}%</text>`}).join('');$('#durationResult').innerHTML=`<div class="kpi-grid"><div class="kpi"><span>重新定价的价格变化</span><strong>${signed(exact)}%</strong><small>${fmt(base.price)}元 至 ${fmt(next.price)}元</small></div><div class="kpi"><span>修正久期</span><strong>${fmt(base.modified)}</strong><small>麦考利久期 ${fmt(base.macaulay)}年</small></div><div class="kpi"><span>久期线性近似</span><strong>${signed(linear)}%</strong><small>凸性修正后 ${signed(conv)}%</small></div><div class="kpi"><span>每面值100元的 DV01</span><strong>${fmt(base.dv01,4)}元</strong><small>初始收益率下的局部近似</small></div></div><div class="chart-panel"><h3>同样一场利率变化，期限让反应不同</h3><p class="quiet">固定当前票息，以各期限在初始收益率${fmt(y0)}%时的价格为基准，重新计算价格变化。</p><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="3年、10年与30年债券价格相对初始价格随收益率变化的计算曲线">${grid}${ticks}<line x1="${x(y0)}" y1="${T}" x2="${x(y0)}" y2="${H-B}" stroke="var(--muted)" stroke-dasharray="4 5"/>${samples.map((s,i)=>`<path d="${svgLine(s,x,py)}" stroke="${colors[i]}" fill="none" stroke-width="3"/>`).join('')}<text x="${(W+L-R)/2}" y="${H-3}" text-anchor="middle">冲击后的到期收益率</text><text x="${L}" y="14">价格变化</text></svg><div class="legend">${terms.map((t,i)=>`<span><i style="background:${colors[i]}"></i>剩余${t}年</span>`).join('')}</div></div><div class="formula">P(y)＝Σ CFₜ / (1＋y)ᵗ<br>ΔP/P ≈ −Dmod × Δy ＋ ½ × C × (Δy)²</div><div class="table-wrap"><table><thead><tr><th>同票息、同收益率的对照</th><th>初始价格</th><th>修正久期</th><th>冲击${signed(bps,0)}bp后价格变化</th></tr></thead><tbody>${[...new Set([3,10,30,n])].sort((a,b)=>a-b).map(t=>{let a=bondMetrics(t,c,y0),z=bondMetrics(t,c,y0+bps/100);return `<tr><td>${t}年${t===n?' · 当前选择':''}</td><td>${fmt(a.price)}元</td><td>${fmt(a.modified)}</td><td>${signed((z.price/a.price-1)*100)}%</td></tr>`}).join('')}</tbody></table></div><p class="lab-note">计算假设：面值100元，固定票息，每年付息一次，到期还本；估值日为付息后，剩余期限为整数年。冲击立即发生，现金流不变。未包含持有期票息、滚降、再投资、税费、违约与流动性折价。曲线为模型计算，非历史行情；现实债券的付息频率、应计利息与估值规则可能不同。1bp＝0.0001，公式中y与Δy使用小数。</p>`}
function spreadLab(){return `<div class="controls">${control('baseMove','基准收益率变化',-30,-150,150,5,'bp')}${control('spreadMove','信用利差变化',80,-150,150,5,'bp')}${control('spreadDuration','修正久期',4,1,20,.5,'')}</div><div id="spreadResult"></div>`}
function drawSpread(){const b=+$('#baseMove').value,s=+$('#spreadMove').value,d=+$('#spreadDuration').value,total=b+s,part1=-d*b/100,part2=-d*s/100;$('#spreadResult').innerHTML=`<div class="kpi-grid"><div class="kpi"><span>总收益率变化</span><strong>${signed(total,0)}bp</strong><small>基准变化＋利差变化</small></div><div class="kpi"><span>基准项价格影响</span><strong>${signed(part1)}%</strong><small>线性近似</small></div><div class="kpi"><span>利差项价格影响</span><strong>${signed(part2)}%</strong><small>线性近似</small></div><div class="kpi"><span>合计近似价格变化</span><strong>${signed(part1+part2)}%</strong><small>未含票息与其他风险</small></div></div><section class="panel"><h2>${total>0?'基准可能走好，合计收益率仍可能上行':total<0?'合计收益率下行，形成价格上的正向影响':'两项在本设定下相互抵消'}</h2><p>当前基准变化${signed(b,0)}bp，利差变化${signed(s,0)}bp，合计${signed(total,0)}bp。用同一个修正久期${d}作简化分解，得出价格影响约${signed(part1+part2)}%。</p><div class="causal-flow"><div>基准 ${signed(b,0)}bp</div><div>利差 ${signed(s,0)}bp</div><div>合计 ${signed(total,0)}bp</div></div><div class="formula">Δy总＝Δy基准＋Δs<br>ΔP/P ≈ −Dmod × (Δy基准＋Δs)</div><p class="lab-note">本实验把基准久期与利差久期简化为相同，并忽略凸性与现金流变化，只用于解释方向。真实信用事件、非平行曲线、含权条款和流动性变化需要额外建模。信用利差变化不等于信用扩张变化。</p><button class="button" data-go="read/b2-3">阅读利率债与信用债</button></section>`}
function curveLab(){return `<div class="controls">${control('shortYield','1年期收益率',2,0,6,.1,'%')}${control('midYield','5年期收益率',2.6,0,6,.1,'%')}${control('longYield','10年期收益率',3,0,6,.1,'%')}</div><div id="curveResult"></div>`}
function drawCurve(){const a=+$('#shortYield').value,m=+$('#midYield').value,b=+$('#longYield').value,spread=(b-a)*100;const x=t=>65+(t-1)/9*635,y=v=>260-v/6*225;$('#curveResult').innerHTML=`<div class="split-grid"><div class="chart-panel"><h3>三点收益率曲线</h3><svg viewBox="0 0 760 320" role="img" aria-label="由自选1年、5年和10年期收益率组成的示意曲线">${[0,2,4,6].map(v=>`<line x1="65" y1="${y(v)}" x2="700" y2="${y(v)}" stroke="var(--line)"/><text x="50" y="${y(v)+5}" text-anchor="end">${v}%</text>`).join('')}<path d="${svgLine([[1,a],[5,m],[10,b]],x,y)}" stroke="var(--accent)" stroke-width="4" fill="none"/>${[[1,a],[5,m],[10,b]].map(([t,v])=>`<circle cx="${x(t)}" cy="${y(v)}" r="6" fill="var(--accent)"/><text x="${x(t)}" y="${y(v)-16}" text-anchor="middle">${fmt(v,1)}%</text><text x="${x(t)}" y="292" text-anchor="middle">${t}年</text>`).join('')}</svg></div><div class="lab-explain"><div class="eyebrow">长短端关系</div><h3>${Math.abs(spread)<.1?'长短端持平':spread>0?'10年期高于1年期':'10年期低于1年期'}</h3><p>10年减1年期限利差为 <strong>${signed(spread,0)}bp</strong>。这描述两个期限的相对水平，不会独立证明未来增长方向。</p><p>拖动中间期限，可看到同一长短端利差也能对应不同的曲线形状。讨论“变陡、变平”还需要一个前期曲线作为比较。</p><p class="lab-note">本图由三个自选点直线连接，仅为概念示意。假定信用与其他条件可比，未接入真实债券收益率；不据此判断今日市场形态。</p><button class="button" data-go="read/b1-3">阅读利率背离的解释</button></div></div>`}
function equityLab(){return `<div class="controls">${control('bondYield','债券到期收益率',2.5,.5,7,.1,'%')}${control('divYield','股票股息率',3.5,0,8,.1,'%')}${control('pe','市盈率',15,5,50,1,'倍')}</div><div id="equityResult"></div>`}
function drawEquity(){const b=+$('#bondYield').value,d=+$('#divYield').value,pe=+$('#pe').value,ey=100/pe;$('#equityResult').innerHTML=`<div class="kpi-grid"><div class="kpi"><span>股息率</span><strong>${fmt(d)}%</strong><small>分红与股价之比</small></div><div class="kpi"><span>盈利收益率</span><strong>${fmt(ey)}%</strong><small>1 / 市盈率</small></div><div class="kpi"><span>债券收益率减股息率</span><strong>${signed(b-d)}</strong><small>个百分点</small></div><div class="kpi"><span>债券收益率减盈利收益率</span><strong>${signed(b-ey)}</strong><small>个百分点</small></div></div><section class="panel"><h2>同样相减，含义很不一样</h2><div class="table-wrap"><table><thead><tr><th>比较口径</th><th>计算结果</th><th>不能自动推出什么</th></tr></thead><tbody><tr><td>债券收益率 − 股息率</td><td>${fmt(b)}% − ${fmt(d)}%＝${signed(b-d)}个百分点</td><td>不等于股票与债券的确定性持有回报差</td></tr><tr><td>债券收益率 − 市盈率倒数</td><td>${fmt(b)}% − ${fmt(ey)}%＝${signed(b-ey)}个百分点</td><td>盈利不等于全部分红，也不是保证收益</td></tr></tbody></table></div><div class="callout"><strong>先写清谁减谁</strong><p>如果把相减顺序反过来，正负号也会反过来。比较历史阈值前，应先核对口径、指数构成、盈利周期和数据时点。</p></div><p class="lab-note">参数为教学设定；没有采用作者原始模型、经验阈值或实时市场数据。市盈率范围限定为正数，亏损企业不适用这一简化比较。</p><button class="button" data-go="read/b4-3">阅读股债收益差</button></section>`}
function refreshLab(){const type=current.split('/')[1];document.querySelectorAll('[data-range]').forEach(r=>{let units={maturity:'年',coupon:'%',baseYield:'%',shock:'bp',baseMove:'bp',spreadMove:'bp',shortYield:'%',midYield:'%',longYield:'%',bondYield:'%',divYield:'%',pe:'倍'};const out=$('#'+r.id+'Out');if(out)out.textContent=r.value+(units[r.id]||'')});if(type==='duration')drawDuration();if(type==='spread')drawSpread();if(type==='curve')drawCurve();if(type==='equity')drawEquity()}
function glossaryView(){return `<div class="page-head"><div class="eyebrow">Glossary</div><h1>读到一个词，就把它讲清楚</h1><p>${Object.keys(DATA.glossary).length}个基础术语，按本页面使用口径解释。点击相关导读可回到概念的具体语境。</p></div><input id="glossaryFilter" class="filter-input" placeholder="筛选术语或解释…" aria-label="筛选术语"><div class="glossary-grid" id="glossaryGrid">${glossaryCards('')}</div>`}
function glossaryCards(q){return Object.entries(DATA.glossary).filter(([k,v])=>(k+v).toLowerCase().includes(q.toLowerCase())).map(([k,v])=>`<section class="term-card"><h3>${e(k)}</h3><p>${e(v)}</p><button class="button" data-go="read/${DATA.units.find(u=>u.terms.includes(k))?.id||'b1-1'}">阅读相关导读</button></section>`).join('')||'<p class="quiet">没有匹配的术语，试试“利率”“信用”或“流动性”。</p>'}
function notesView(){const notes=DATA.units.filter(u=>typeof state.notes[u.id]==='string'&&state.notes[u.id].trim()),marks=DATA.units.filter(u=>state.marks.includes(u.id));return `<div class="page-head"><div class="eyebrow">Personal reading</div><h1>把读过的，变成自己的理解</h1><p>已读${state.done.length}个单元，${notes.length}条笔记，${marks.length}个书签。笔记和进度保存在当前浏览器，不会自动同步到其他设备；可下载备份，也可从备份恢复。</p></div><div class="actions"><button class="button" id="exportNotes">下载笔记备份</button><button class="button" id="importNotes">恢复笔记备份</button><input id="notesFile" type="file" accept="application/json,.json" hidden></div><div class="section-title"><h2>书签</h2><span>${marks.length}个单元</span></div>${marks.length?`<div class="pills">${marks.map(u=>`<button class="button" data-go="read/${u.id}">${e(u.title)}</button>`).join('')}</div>`:'<p class="quiet">在阅读单元中点击“加入书签”，可在这里快速找回。</p>'}<div class="section-title"><h2>我的笔记</h2><span>${notes.length}条</span></div>${notes.length?notes.map(u=>`<section class="notes-card"><div class="eyebrow">${bookById(u.book).suffix}</div><h3>${e(u.title)}</h3><p>${e(state.notes[u.id])}</p><button class="button" data-go="read/${u.id}">继续阅读与编辑</button></section>`).join(''):'<div class="empty"><strong>第一条理解，从一个问题开始</strong>在阅读页写下想法，这里会自动汇集。<div class="actions" style="justify-content:center"><button class="button" data-go="read/b1-1">开始第一个单元</button></div></div>'}`}
function sourcesView(){return `<div class="page-head"><div class="eyebrow">Sources & scope</div><h1>哪些来自书目，哪些是本页补充</h1><p>当前没有取得用户提供的原书文件。页面依据公开目录与简介确认四册范围，再以原创文字、例子和交互实验解释相关基础概念。</p></div><div class="split-grid"><section class="panel"><h3>已经核实</h3><p>四册的作者、书名、覆盖年份、出版社、出版年与ISBN；以及公开目录或简介出现的主要研究主题。不同渠道的页数、月份可能有差别，本页不将其作为精确版本识别依据。</p></section><section class="panel"><h3>目前的内容范围</h3><p>16个单元是本页面编排的主题导读；不是原书全文、逐章摘要或作者观点的完整还原。所有解释、例子、计算器与学习问题均为本页补充，不冒充董德志原话或专有模型。</p></section></div><div class="section-title"><h2>四册书目</h2><span>核实日期 ${DATA.checked}</span></div><div class="table-wrap panel" style="padding:0"><table><thead><tr><th>书名</th><th>覆盖时期</th><th>出版年</th><th>ISBN</th></tr></thead><tbody>${DATA.books.map(b=>`<tr><td><a href="${e(b.source)}" target="_blank" rel="noopener noreferrer">${e(b.name)}</a></td><td>${b.years}</td><td>${b.published}</td><td>${b.isbn}</td></tr>`).join('')}</tbody></table></div><div class="section-title"><h2>可追溯的资料</h2></div>${DATA.sources.map(s=>`<section class="notes-card"><div class="eyebrow">${e(s.kind)}</div><h3><a href="${e(s.url)}" target="_blank" rel="noopener noreferrer">${e(s.name)}</a></h3><p style="white-space:normal;margin:0">${e(s.scope)}</p></section>`).join('')}<section class="panel"><h3>图表与数据说明</h3><p>债券价格实验按固定票息、年付息一次的现金流现值计算。其余图表为自选参数或分类情景。没有伪造历史收益率、回测结果或实时数据，也未据公开目录补造作者未公开的模型公式。</p><p style="margin-bottom:0">学习记录只在浏览器中保存。页面提供备份与恢复；未部署云端笔记服务。内容用于概念学习，不对当前市场作交易判断。</p></section>`}
function missing(){return `<div class="empty"><strong>这个阅读位置不存在</strong><button class="button" data-go="home">回到四册总览</button></div>`}
function render(){current=decodeURIComponent(location.hash.slice(1)||'home');const parts=current.split('/');const names={home:'四册总览',map:'框架图谱',timeline:'历史阅读路线',glossary:'术语索引',notes:'笔记与书签',sources:'资料与阅读说明',lab:'交互实验室'};$('#breadcrumb').textContent=parts[0]==='read'?unitById(parts[1])?.title||'阅读单元':parts[0]==='book'?bookById(parts[1])?.name||'书籍导读':names[parts[0]]||'阅读室';let body=parts[0]==='read'?lessonView(parts[1]):parts[0]==='book'?bookView(parts[1]):parts[0]==='lab'?labView(parts[1]):current==='home'?home():current==='map'?mapView():current==='timeline'?timelineView():current==='glossary'?glossaryView():current==='notes'?notesView():current==='sources'?sourcesView():missing();$('#main').innerHTML=body+footer();sidebar();applyPrefs();$('#sidebar').classList.remove('open');$('#menuToggle').setAttribute('aria-expanded','false');if(parts[0]==='lab')refreshLab();window.scrollTo(0,0);document.title=($('#breadcrumb').textContent==='四册总览'?'董德志 · 投资交易笔记':$('#breadcrumb').textContent)+'｜可视化阅读'}
function closeModal(type){$('#'+type+'Modal').hidden=true;if(lastFocus&&document.contains(lastFocus))lastFocus.focus()}
function openSearch(){lastFocus=document.activeElement;$('#searchModal').hidden=false;$('#searchInput').value='';search('');$('#searchInput').focus()}
function search(q){const needle=q.trim().toLowerCase();const hits=DATA.units.filter(u=>!needle||[u.title,u.deck,...u.sections.map(s=>s.title+s.text),u.example,...u.terms].join(' ').toLowerCase().includes(needle));const terms=Object.entries(DATA.glossary).filter(([k,v])=>needle&&(k+v).toLowerCase().includes(needle));$('#searchResults').innerHTML=`<p class="quiet" style="margin:8px 0 15px">${needle?`${hits.length}个导读单元 · ${terms.length}个术语`:'按关键词找概念、例子与问题'}</p>`+terms.slice(0,5).map(([k,v])=>`<button class="search-result" data-term="${e(k)}"><strong>${e(k)}</strong><span>术语 · ${e(v)}</span></button>`).join('')+hits.map(u=>`<button class="search-result" data-searchgo="read/${u.id}"><strong>${e(u.title)}</strong><span>${bookById(u.book).suffix} · ${e(u.deck)}</span></button>`).join('')+(hits.length||terms.length?'':'<p class="quiet">未找到结果，试试“久期”“信用”或“通胀”。</p>')}
function showTerm(term){const v=DATA.glossary[term];if(!v)return;lastFocus=document.activeElement;$('#searchModal').hidden=true;$('#termTitle').textContent=term;$('#termBody').textContent=v;$('#termBody').style.lineHeight='2';$('#termRelated').innerHTML=DATA.units.filter(u=>u.terms.includes(term)).slice(0,4).map(u=>`<button class="button" data-searchgo="read/${u.id}">${e(u.title)}</button>`).join('');$('#termModal').hidden=false;$('#termModal [data-close]').focus()}
document.addEventListener('click',event=>{const target=event.target.closest('button,a');if(!target)return;if(target.dataset.go){go(target.dataset.go);return}if(target.dataset.searchgo){$('#searchModal').hidden=true;$('#termModal').hidden=true;go(target.dataset.searchgo);return}if(target.dataset.close){closeModal(target.dataset.close);return}if(target.dataset.term){showTerm(target.dataset.term);return}if(target.dataset.scroll){document.getElementById(target.dataset.scroll)?.scrollIntoView({behavior:'smooth'});return}if(target.dataset.done){const id=target.dataset.done;state.done=state.done.includes(id)?state.done.filter(x=>x!==id):[...state.done,id];const ok=save();target.textContent=state.done.includes(id)?'已读 · 点击撤销':'标记本单元已读';target.setAttribute('aria-pressed',state.done.includes(id));sidebar();showToast(ok?'阅读进度已保存':'本次已更新，浏览器暂时无法保存');return}if(target.dataset.mark){const id=target.dataset.mark;state.marks=state.marks.includes(id)?state.marks.filter(x=>x!==id):[...state.marks,id];const ok=save();target.textContent=state.marks.includes(id)?'已加入书签':'加入书签';target.setAttribute('aria-pressed',state.marks.includes(id));target.classList.toggle('active',state.marks.includes(id));showToast(ok?'书签已更新':'本次已更新，浏览器暂时无法保存');return}if(target.dataset.quad){quad=target.dataset.quad;$('#labContent').innerHTML=quadrantLab(target.dataset.quadtype);return}if(target.id==='searchOpen')openSearch();if(target.id==='menuToggle'){const open=$('#sidebar').classList.toggle('open');target.setAttribute('aria-expanded',open)}if(target.id==='fontToggle'){state.font=({16:18,18:20,20:22,22:16})[state.font];save();applyPrefs();showToast('正文字号 '+state.font)}if(target.id==='themeToggle'){state.dark=!state.dark;save();applyPrefs()}if(target.id==='exportNotes'){const payload={format:'clair-dong-reading-v1',exportedAt:new Date().toISOString(),...state};const url=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='dong-dezhi-reading-notes.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}if(target.id==='importNotes')$('#notesFile').click()});
document.addEventListener('input',event=>{const t=event.target;if(t.id==='searchInput')search(t.value);if(t.id==='glossaryFilter')$('#glossaryGrid').innerHTML=glossaryCards(t.value);if(t.id==='lessonNote'){if(t.value.length>50000)t.value=t.value.slice(0,50000);state.notes[t.dataset.unit]=t.value;$('#noteStatus').textContent=save()?'已保存 · 当前浏览器':'保存失败，请复制笔记备份'}if(t.dataset.range)refreshLab()});
document.addEventListener('change',async event=>{if(event.target.id!=='notesFile')return;const file=event.target.files[0];if(!file)return;try{if(file.size>2*1024*1024)throw Error('备份文件过大');const v=JSON.parse(await file.text());if(v.format!=='clair-dong-reading-v1'||!Array.isArray(v.done)||!Array.isArray(v.marks)||!v.notes||typeof v.notes!=='object'||Array.isArray(v.notes))throw Error('不是本页面的笔记备份');for(const u of DATA.units){if(typeof v.notes[u.id]==='string')state.notes[u.id]=v.notes[u.id].slice(0,50000)}state.done=[...new Set([...state.done,...v.done.filter(x=>unitById(x))])];state.marks=[...new Set([...state.marks,...v.marks.filter(x=>unitById(x))])];if(!save())throw Error('浏览器无法保存，已暂存本次会话');render();showToast('笔记与阅读进度已恢复')}catch(err){showToast(err.message||'无法读取这份备份')}event.target.value=''});
document.addEventListener('keydown',event=>{const modal=!$('#searchModal').hidden?$('#searchModal'):!$('#termModal').hidden?$('#termModal'):null;if(event.key==='Escape'){if(!$('#searchModal').hidden)closeModal('search');if(!$('#termModal').hidden)closeModal('term');$('#sidebar').classList.remove('open');$('#menuToggle').setAttribute('aria-expanded','false')}if((event.metaKey||event.ctrlKey)&&event.key.toLowerCase()==='k'){event.preventDefault();openSearch()}if(modal&&event.key==='Tab'){const focusable=[...modal.querySelectorAll('button,input,a,textarea')].filter(x=>!x.hidden&&!x.disabled);if(!focusable.length)return;const first=focusable[0],last=focusable[focusable.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus()}}});
for(const type of ['search','term'])$('#'+type+'Modal').addEventListener('click',event=>{if(event.target===$('#'+type+'Modal'))closeModal(type)});
window.addEventListener('hashchange',render);render();
</script>
</body>
</html>