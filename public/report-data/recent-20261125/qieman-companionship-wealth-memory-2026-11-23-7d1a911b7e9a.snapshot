:root{--ink:#1a293a;--muted:#58687a;--paper:#f5f7fa;--white:#fff;--navy:#182a43;--accent:#934d56;--line:#dce2e9;--blue:#3c5e88;--soft:#e9eef5}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:25px}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.85 -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}a{color:var(--blue);text-underline-offset:4px}button{font:inherit;cursor:pointer}button,a,summary{touch-action:manipulation}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #9c7d86;outline-offset:5px}.top{display:flex;align-items:center;justify-content:space-between;padding:18px 5vw;border-bottom:1px solid var(--line);background:#fff}.brand{font-size:16px;letter-spacing:2px;font-weight:700}.meta{font-size:14px;color:var(--muted)}.frame{max-width:1420px;margin:35px auto 85px;padding:0 30px;display:grid;grid-template-columns:165px minmax(0,1080px);gap:40px}.rail{position:sticky;top:30px;height:max-content}.rail a{display:block;text-decoration:none;color:var(--muted);font-size:14px;margin:15px 0}.rail .label{font-size:13px;color:var(--accent);letter-spacing:2px}.hero{background:var(--navy);color:#fff;padding:54px 54px 40px;border-radius:5px;position:relative;overflow:hidden}.hero .overline{color:#d9b8bd}.hero h1{font-family:"Songti SC","STSong",serif;font-size:clamp(36px,4.5vw,59px);line-height:1.4;font-weight:500;margin:18px 0 25px;letter-spacing:1px}.hero p{color:#dce4f0;max-width:790px;font-size:18px}.hero-foot{border-top:1px solid #ffffff29;padding-top:23px;margin-top:38px;font-size:14px;color:#c8d3e0}.overline{font-size:13px;letter-spacing:1px;color:var(--accent);font-weight:650}.intro{font-size:21px;line-height:1.9;margin:28px 0 8px}.section{padding-top:64px}h2{font-size:30px;line-height:1.5;margin:8px 0 16px;font-weight:650;letter-spacing:-.4px}h3{font-size:19px;line-height:1.6;margin:0 0 12px}p{margin:0 0 15px}.lead{color:var(--muted);font-size:17px;margin-bottom:25px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{padding:25px;border:1px solid var(--line);background:#fff;border-radius:4px}.card .overline{margin-bottom:14px}.card p{color:var(--muted)}.pull{border-left:3px solid var(--accent);background:#ece9ee;padding:22px 27px;font-family:"Songti SC","STSong",serif;font-size:24px;line-height:1.8;margin:25px 0}.tablebox{overflow:auto;background:#fff;border:1px solid var(--line);border-radius:4px}table{border-collapse:collapse;width:100%;font-size:15px;line-height:1.8}th,td{padding:19px 20px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}thead{background:#e9eef4}th{font-weight:650}tbody th{min-width:130px}td p{margin:8px 0 0;color:var(--muted)}tr:last-child td,tr:last-child th{border-bottom:0}.small{font-size:14px;color:var(--muted)}.cite{font-size:13px;color:var(--accent);white-space:nowrap}.note{padding:18px 24px;border:1px solid #cfd9e5;background:#ecf1f7;margin:20px 0;font-size:15px}.evidence{display:flex;gap:15px;align-items:baseline;margin:10px 0 25px}.evidence b{font-size:18px;min-width:100px}.evidence p{margin:0;color:var(--muted)}.tabs{display:flex;gap:9px;flex-wrap:wrap;margin:20px 0}.tabs button,.btn{border:1px solid #bac5d1;background:#fff;padding:9px 17px;border-radius:30px;font-size:15px;color:var(--ink);text-decoration:none;display:inline-block}.tabs button[aria-selected=true],.tabs button[aria-pressed=true]{background:var(--navy);color:#fff;border-color:var(--navy)}.sample-frame{background:#e9edf3;border:1px solid var(--line);padding:26px;border-radius:5px}.sample-note{font-size:14px;color:var(--muted);margin-bottom:17px}.sample-content{background:#fff;padding:38px 42px;border-top:4px solid var(--accent);box-shadow:0 10px 25px #1b2d4410;min-height:480px}.sample-content h3{font-family:"Songti SC","STSong",serif;font-size:28px;font-weight:500;margin:15px 0 25px}.letter{font-family:"Songti SC","STSong",serif;font-size:20px;line-height:2.05}.letter p{margin-bottom:22px}.signature{text-align:right;margin-top:25px}.archive .item{display:grid;grid-template-columns:120px 1fr;gap:20px;border-bottom:1px solid var(--line);padding:17px 0}.archive .item:last-child{border-bottom:0}.archive b{font-weight:600}.archive .item p{margin:0}.memory{padding:18px 0 24px 25px;border-left:2px solid #d3b8bd;position:relative}.memory:before{content:"";position:absolute;left:-6px;top:25px;width:10px;height:10px;border-radius:50%;background:var(--accent)}.memory time{color:var(--accent);font-size:14px}.memory h4{font-family:"Songti SC","STSong",serif;font-size:23px;font-weight:500;margin:8px 0 12px}.memory .prompt{border-bottom:1px solid #d8dde3;padding-bottom:12px;font-size:14px;color:var(--muted)}.flow{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.flow .card{border-top:3px solid #8293ab}.flow h3{margin-top:10px}.flow p{font-size:15px}.source-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.source{border-top:1px solid var(--line);padding:22px 0 10px}.source h3{margin:10px 0 7px;font-size:17px}.source p{font-size:15px;color:var(--muted);margin-top:12px}details{background:#fff;border:1px solid var(--line);padding:20px 23px;margin:18px 0;border-radius:4px}summary{cursor:pointer;font-weight:600}pre{overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;background:#f0f3f6;padding:22px;font:14px/1.8 ui-monospace,SFMono-Regular,monospace;color:#23364c;max-height:600px}code{font-family:ui-monospace,SFMono-Regular,monospace}ul{padding-left:22px}.footer{border-top:1px solid var(--line);margin-top:60px;padding-top:22px;font-size:14px;color:var(--muted)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}#toast{font-size:14px;color:var(--accent);min-height:25px;margin-top:10px}.status{font-size:14px;color:#65758a;border:1px solid var(--line);padding:10px 14px;background:#fff;margin-top:18px}
@media(max-width:1000px){.frame{grid-template-columns:1fr;padding:0 22px;gap:10px}.rail{position:static;display:flex;flex-wrap:wrap;gap:0 20px}.rail .label{display:none}.rail a{margin:7px 0}.hero{padding:40px 32px}.grid3,.flow{grid-template-columns:1fr}.hero p{font-size:17px}.sample-content{padding:28px}}@media(max-width:650px){.top{display:block;padding:15px 22px}.meta{margin-top:6px}.grid2,.source-grid{grid-template-columns:1fr}.hero h1{font-size:36px}.frame{padding:0 15px}.hero{padding:32px 25px}.section{padding-top:45px}h2{font-size:26px}.sample-frame{padding:15px}.sample-content{padding:23px 21px}.letter{font-size:18px}.archive .item{display:block}.archive .item b{display:block;margin-bottom:6px}.evidence{display:block}.evidence p{margin-top:7px}.intro{font-size:19px}.tabs button{padding:8px 12px}.pull{font-size:21px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}@media print{.rail,.tabs,.actions,.top button,details,#toast{display:none}.frame{display:block;margin:0;padding:0}.hero{background:#fff;color:#1a293a;padding:20px 0}.hero p,.hero-foot,.hero .overline{color:#33475d}.section{padding-top:30px}.sample-frame{padding:0;border:0;background:transparent}.sample-content{box-shadow:none;border:1px solid #ddd}.source-grid{display:block}.card,.memory,.source{break-inside:avoid}.footer{margin-top:20px}}
</style></head>
<body><header class="top"><div class="brand">且慢 ／ 写给具体的人</div><div class="meta">Clair · 2026.11.23 · 公开作品研究与原创样张</div></header><div class="frame"><aside class="rail" aria-label="报告目录"><div class="label">CONTENTS</div><a href="#choice">先找对人</a><a href="#response">读者为什么回应</a><a href="#method">把长处变成方法</a><a href="#samples">打开三种成品</a><a href="#skill">可复用 SKILL</a><a href="#production">走向每位客户</a><a href="#sources">原始作品与证据</a></aside><main>
<section class="hero"><div class="overline">一封信 · 一份档案 · 一段记忆</div><h1>为真实的人，<br>留一句准确的话。</h1><p>从且慢最值得研究的陪伴文字里，提炼关心人的方式。把每个人与钱、时间和生活的关系，写成一份愿意留下的礼物。</p><div class="hero-foot">研究结论来自公开署名、作品与可见回应；全部客户样张均为虚构。<br>核验日：2026-11-23 · 演示数据截至：2026-11-20 · 内容为阶段版。</div></section>
<p class="intro">就这次任务，我会先找<strong>林杰才和 Iris</strong>一起打磨文字；研究<strong>E大</strong>如何在波动中维持信任，再用<strong>郭志强与且慢团队</strong>的专业方法把档案撑起来。</p>
<p class="lead">“谁最好”要放在成品里判断。我给的是有作品依据的优先选择；目前没有全量作者、粉丝和内部质检数据，不能把它写成客观榜单。</p>

<section class="section" id="choice"><div class="overline">先找对人</div><h2>三种成品，需要不同的长处</h2><div class="grid3"><article class="card"><div class="overline">一封信</div><h3>林杰才：让经历有意义</h3><p>周年来信把共同经历组织成价值，也承认仍有不足。适合提炼这封信为什么值得写给一个人。</p><a href="#S01">看代表作品</a></article><article class="card"><div class="overline">财富记忆</div><h3>Iris：把一个人写出来</h3><p>从职业、生活和当事人的说法开始，让钱在具体的人生里出现。是这次财富记忆最贴切的参照。</p><a href="#S03">看人物访谈</a></article><article class="card"><div class="overline">财富档案</div><h3>郭志强与团队：把事说清楚</h3><p>账户、用途、时间与持续复核，形成客户可以理解、修改和带走的底稿。</p><a href="#S06">看账户专栏</a></article></div>
<div class="tablebox" style="margin-top:24px"><table><thead><tr><th>人／团队</th><th>最值得学习的长处</th><th>本次编辑判断</th><th>依据与边界</th></tr></thead><tbody><tr><th>林杰才</th><td><b>来信的价值结构</b><p>共同经历如何变成值得留下的一封信。</p></td><td>最适合做私人来信的首轮共创对象。</td><td><span class="cite">S01 · S02</span><p class="small">周年信有交叉归属依据；不能把机构号所有文章归给他。</p></td></tr><tr><th>Iris</th><td><b>人物叙事与财富记忆</b><p>记住职业、愿望、选择与一个人的说法。</p></td><td>这次“财富记忆”的首选方法来源。</td><td><span class="cite">S03 · S04</span><p class="small">公开笔名与节目身份可核验；真实姓名、现职与撰稿分工未取得。</p></td></tr><tr><th>ETF拯救世界</th><td><b>波动中的关系与信任</b><p>困难时直说事实，并解释自己承担什么责任。</p></td><td>最值得研究波动期沟通的主理人之一。</td><td><span class="cite">S05 · S09</span><p class="small">不是本轮全量反响排名；原文中的结果承诺不照搬。</p></td></tr><tr><th>郭志强</th><td><b>持续的具体陪伴</b><p>用家庭账户和固定复核，把专业解释放回生活用途。</p></td><td>财富档案的用途和时间结构。</td><td><span class="cite">S06 · S07</span><p class="small">参考历史栏目，未取得完整留言与2026年任职资料。</p></td></tr><tr><th>且慢内容／投顾团队</th><td><b>专业底稿与集体方法</b><p>把四笔钱、目标与实际操作讲清楚。</p></td><td>财富档案的专业底稿来源。</td><td><span class="cite">S08</span><p class="small">作品与奖项为团队署名，不能授予某个个人。</p></td></tr><tr><th>简七、孟岩</th><td><b>易懂、反思与情感表达</b><p>把自己的经历讲清楚，让读者保留自己的选择。</p></td><td>历史合作及历史陪伴文字的外部参照。</td><td><span class="cite">S09 · S10</span><p class="small">孟岩已于2019年底离开；不列为现有内部写作资源。</p></td></tr></tbody></table></div>
<div class="note"><b>关于“文笔最好”的直接回答：</b>若限定为这次且慢客户来信，我首选研究林杰才的结构和 Iris 的人物感；若把历史且慢相关写作者也纳入，孟岩值得作为情感表达参照。这个判断依据适配度与可读作品，不等同于现任员工排名。金栋的历史团队问答也值得补进“解释取舍”的样本；其2021年身份已见于有知有行访谈。</div>
</section>

<section class="section" id="response"><div class="overline">读者为什么回应</div><h2>被记住的，是关系中的具体价值</h2><div class="grid2"><article class="card"><h3>公开评论：从理解到信任</h3><p>在孟岩与简七的对话页，清風谈到从极简投资认识且慢、E大和有知有行；罗敏提到投资经验影响了自己对未来的安排。setoff回顾了信任关系变化时的不安。</p><p class="small">这是可直接阅读的个体评论，部分被置顶。不能推算总体满意度，也不能证明哪位作者排名第一。</p><a href="#S09">查看评论原页</a></article><article class="card"><h3>人物访谈：让精力回到自己的生活</h3><p>鱼尾君的访谈，把海上工作、摄影爱好与理财服务放在同一个人身上。其反馈指向节省精力与安心，提醒我们寻找钱在生活中实际帮过什么。</p><p class="small">这是栏目选择和编辑的受访个案，不是独立用户调研，更不代表所有用户。</p><a href="#S03">查看完整访谈</a></article></div>
<div class="evidence"><b>机构转述</b><p>林杰才来信的读者留言、四笔钱图书的读者实践，均能提供选题线索；仍需回到原始记录和本人确认，才能成为某位客户的故事。<a href="#S02">S02</a> · <a href="#S08">S08</a></p></div>
<div class="pull">真正值得带进 Skill 的问题是：<br>我们能否准确说出，这笔钱曾经怎样参与了你的生活？</div>
<p class="small">本轮没有取得内部作者分工、顾问服务质检、完整评论串与反向反馈数据。Iris 的公开笔名和历史节目身份可以核验，真实姓名与现职未核实；本报告不据此推断。内部人员的进一步选择应做同题试写和客户盲评。</p>
</section>

<section class="section" id="method"><div class="overline">把长处变成方法</div><h2>先找到事实，再决定怎样动人</h2><div class="flow"><article class="card"><div class="overline">事实底稿</div><h3>记录了什么</h3><p>账户的变化、已经完成的取用、本人确认的目标与原话。系统记录和本人说明分别保留来源。</p></article><article class="card"><div class="overline">人物线索</div><h3>为什么与他有关</h3><p>只用本人确认过的生活意义。一个愿望、一门课程、一段想留给自己的时间，都可以成为主题。</p></article><article class="card"><div class="overline">原创成品</div><h3>留下什么</h3><p>信提供被认真看见的感受；档案给出准确的发现；记忆保存可重读、可改写的时刻。</p></article></div>
<div class="tablebox" style="margin-top:24px"><table><thead><tr><th>需要的品质</th><th>写作动作</th><th>具体判断</th></tr></thead><tbody><tr><th>坦诚</th><td>亏损、费用和服务不足直接写清</td><td>生活意义不能抵消真实损失。</td></tr><tr><th>人物感</th><td>保留本人说过的一句话、一个已经发生的事件</td><td>交易能证明发生，不能证明当时怎么想。</td></tr><tr><th>温度</th><td>允许改变、赎回、尚未完成和保持空白</td><td>不把投资选择写成人格高低。</td></tr><tr><th>专业</th><td>投入、取用、损益分开；时点与范围清楚</td><td>余额增长不自动等于投资赚钱。</td></tr><tr><th>收藏感</th><td>留一个具体时刻和一行本人可以补写的位置</td><td>不为凑三段而编造回忆。</td></tr></tbody></table></div></section>

<section class="section" id="samples"><div class="overline">打开三种成品</div><h2>同一份事实，留下三种不同的价值</h2><p class="lead">下面是已经写出的原创样张。可切换客群与成品；所有人物、账户、目标和原话均为虚构。</p><div class="tabs" aria-label="选择虚构客户"><button type="button" data-person="loss" aria-pressed="true">有生活事件 · 账户亏损</button><button type="button" data-person="new" aria-pressed="false">新用户 · 资料很少</button><button type="button" data-person="exit" aria-pressed="false">已全部赎回</button></div><div class="sample-frame"><div class="sample-note" id="sample-context">虚构示例 · 2026阶段版 · 截至11月20日</div><div class="tabs" role="tablist" aria-label="选择成品"><button id="tab-letter" type="button" role="tab" data-view="letter" aria-selected="true" aria-controls="sample-panel">一封信</button><button id="tab-dossier" type="button" role="tab" data-view="dossier" aria-selected="false" aria-controls="sample-panel">财富档案</button><button id="tab-memory" type="button" role="tab" data-view="memory" aria-selected="false" aria-controls="sample-panel">财富记忆</button></div><div id="sample-panel" class="sample-content" role="tabpanel" aria-labelledby="tab-letter" tabindex="0"><div class="overline">虚构样张 · 给你的信</div><h3>为想学的东西，留出了位置</h3><div class="letter"><p>小林：</p><p>9月18日，你从且慢账户取用了2万元。你后来补充，这笔钱付给了一门已经开始的课程。于是，今年这份记录里，有了一个很具体的去处：你为想学的东西，留出了位置。</p><p>截至11月20日，你的且慢账户投资损益是负1.2万元。这笔损失需要被认真看清。期末32.8万元之中，也有你今年新转入的资金；账户余额的增加，不能当成投资赚到的钱。我们在档案里把它们分开列好了。</p><p>3月，你写过一个愿望：去山里住一周。到了11月，你又留下一句：“比起挣得更多，我想留一点可以慢下来的时间。”这两句话可以一起放在这里。具体什么时候出发、要花多少钱，还留着空白，等你来填。</p><p>你补充的银行备用金是7.2万元，必要月支出是8000元。仅按这两项资料估算，约覆盖9个月必要开支。这不是对整体财务安全的判断；若明年还有额外用款，需要一起重新核对。</p><p>这次，先邀请你确认一件事：明年最想为自己留下的那段时间，现在还是去山里的一周吗？答案可以改变。这份档案也可以跟着你的答案慢慢改。</p><p>有些钱还在账户里，有些钱已经用到了生活里。愿这一页，能替你把它们记得清楚一些。</p><p class="signature">且慢</p></div></div><div class="actions"><button class="btn" id="download-text" type="button">保存当前样张文字</button><button class="btn" id="download-data" type="button">保存虚构事实底稿</button></div><div id="toast" role="status" aria-live="polite"></div></div>
<details><summary>展开这封信的事实依据</summary><p class="small">此处为内部审读用的合成底稿。客户版只显示自然语言范围说明。</p><pre>{
